package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ Vote(props VoteProps) {
	@Layout(props.LayoutProps) {
		<div class="space-y-6">
			<!-- Breadcrumb Navigation -->
			<nav class="flex items-center gap-2 text-xs text-slate-500">
				<a href="/" class="hover:text-slate-900 hover:underline transition">← Visi balsojumi</a>
				if props.Vote.BillNumber != "" {
					<span>/</span>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/likumprojekti/%s/", stats.CleanBillSlug(props.Vote.BillNumber))) }
						class="hover:text-slate-900 hover:underline transition font-mono"
					>
						Likumprojekts Nr. { CleanBillNr(props.Vote.BillNumber) }
					</a>
				}
			</nav>

			<!-- Header Article -->
			<article class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6 shadow-2xs space-y-4">
				<!-- Title & Badges -->
				<div class="space-y-2">
					<div class="flex flex-wrap items-center gap-2 text-xs">
						<span class={ "inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold shadow-2xs " + ResultBadgeClass(props.Vote.Result) }>
							{ ResultLabel(props.Vote.Result) }
						</span>
						<span class="font-mono text-slate-500">{ props.Vote.SittingDate } · { props.Vote.SittingTime }</span>
						if props.Vote.BillNumber != "" {
							<span class="font-mono text-slate-400">Nr. { CleanBillNr(props.Vote.BillNumber) }</span>
						}
						if props.Vote.ReadingStage != "" {
							<span class="text-slate-600 font-medium">{ props.Vote.ReadingStage }</span>
						}
						{{ committee := ExtractResponsibleCommittee(props.Vote.Summary) }}
						if committee != "" {
							<span class="text-slate-500">· Atbildīgā: { committee }</span>
						}
					</div>

					<h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 leading-snug">
						{ CleanVoteTitle(props.Vote.SimplifiedTitle) }
					</h1>

					if props.Vote.OfficialTitle != "" && props.Vote.OfficialTitle != props.Vote.SimplifiedTitle {
						<p class="text-xs text-slate-500 leading-relaxed italic">
							Oficiālais formulējums: { props.Vote.OfficialTitle }
						</p>
					}
				</div>

				<!-- Purpose / Summary -->
				{{
					meaningfulPurpose := MeaningfulVotePurpose(props.Vote.Purpose)
				}}
				if meaningfulPurpose != "" {
					<div class="rounded-lg bg-slate-50 p-4 border border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed space-y-1.5">
						<div class="font-semibold text-slate-900">{ PurposeLabel(props.Vote.VoteType, props.Vote.ReadingStage, props.Vote.SimplifiedTitle) } un pamatojums:</div>
						<p>{ meaningfulPurpose }</p>
					</div>
				} else if props.Vote.Summary != "" {
					<div class="rounded-lg bg-slate-50 p-4 border border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed space-y-1.5">
						<div class="font-semibold text-slate-900">Informācija par likumprojektu:</div>
						<p>{ strings.TrimSpace(props.Vote.Summary) }</p>
					</div>
				}

				<!-- Tally Bar -->
				<div class="rounded-xl border border-slate-200 bg-white p-4 space-y-2.5">
					<div class="flex flex-wrap items-center justify-between text-xs sm:text-sm font-mono gap-3">
						<div class="flex items-center gap-3 sm:gap-4">
							<span>
								<strong class="text-base sm:text-lg font-bold text-emerald-700 tabular-nums">{ fmt.Sprint(props.Vote.Counts.Par) }</strong>
								<span class="font-sans text-xs text-slate-500 ml-1">Par</span>
							</span>
							<span class="text-slate-300">·</span>
							<span>
								<strong class="text-base sm:text-lg font-bold text-rose-700 tabular-nums">{ fmt.Sprint(props.Vote.Counts.Pret) }</strong>
								<span class="font-sans text-xs text-slate-500 ml-1">Pret</span>
							</span>
							<span class="text-slate-300">·</span>
							<span>
								<strong class="text-base sm:text-lg font-bold text-amber-700 tabular-nums">{ fmt.Sprint(props.Vote.Counts.Atturas) }</strong>
								<span class="font-sans text-xs text-slate-500 ml-1">Atturas</span>
							</span>
							<span class="text-slate-300">·</span>
							<span>
								<strong class="text-base sm:text-lg font-bold text-slate-400 tabular-nums">{ fmt.Sprint(props.Vote.Counts.Nebalso) }</strong>
								<span class="font-sans text-xs text-slate-400 ml-1">Nebalsoja</span>
							</span>
						</div>

						<div class="text-xs text-slate-500 font-sans">
							Kopā piedalījās: <strong class="text-slate-900 font-mono">{ fmt.Sprint(props.Vote.Counts.TotalPresent) }</strong> deputāti
							if props.Vote.Counts.TotalPresent < 50 {
								<span class="ml-1 text-amber-700 font-semibold">(Nav kvoruma)</span>
							}
						</div>
					</div>
				</div>

				<!-- Hemicycle Section -->
				if props.Vote.IsSecret {
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-8 text-center space-y-2">
						<div class="font-bold text-slate-900 text-sm">Aizklāts balsojums (Satversmes un Kārtības ruļļa procedūra)</div>
						<p class="text-xs text-slate-600 max-w-md mx-auto leading-relaxed">
							Saskaņā ar Satversmi un Saeimas kārtības rulli amatpersonu vēlēšanās individuālie deputātu balsojumi netiek fiksēti un nav publiski pieejami.
						</p>
					</div>
				} else {
					<div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 sm:p-6 space-y-4">
						<div class="flex items-center justify-between text-xs">
							<span class="font-bold text-slate-900">Saeimas sēžu zāle (100 vietas)</span>
							<div class="flex items-center gap-3 text-[11px]">
								<span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Par</span>
								<span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-rose-600"></span> Pret</span>
								<span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Atturas</span>
								<span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> Nebalsoja</span>
							</div>
						</div>

						<!-- Pre-rendered SVG Hemicycle with focusable <a> seat elements -->
						<div class="relative w-full aspect-[640/310] max-w-2xl mx-auto">
							<svg viewBox="0 0 640 310" class="w-full h-full select-none" role="img" aria-label="Saeimas sēžu zāles balsojums">
								for _, seat := range props.Seats {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/deputati/%s/", seat.Slug)) }
										class="cursor-pointer focus:outline-none rounded-full"
										aria-label={ fmt.Sprintf("%s (%s): %s", seat.Name, seat.FactionShort, DecisionLabel(seat.Decision)) }
										tabindex="0"
									>
										<circle
											cx={ fmt.Sprintf("%.1f", seat.X) }
											cy={ fmt.Sprintf("%.1f", seat.Y) }
											r="8"
											fill={ seat.Color }
											stroke="#ffffff"
											stroke-width="1.5"
											class="transition-all hover:stroke-slate-900"
										>
											<title>{ fmt.Sprintf("%s (%s): %s", seat.Name, seat.FactionShort, DecisionLabel(seat.Decision)) }</title>
										</circle>
									</a>
								}
							</svg>
						</div>

						<p class="text-[11px] text-slate-400 text-center">
							Uzbrauciet vai uzklikšķiniet uz deputāta sēdvietas, lai atvērtu viņa profilu un balsojumu analītiku.
						</p>
					</div>

					<!-- Accessible Chamber Audit Table -->
					<div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs space-y-0">
						<div class="px-4 py-3 bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-800">
							Deputātu saraksts ({ fmt.Sprint(len(props.Seats)) } deputāti)
						</div>
						<div class="max-h-96 overflow-y-auto divide-y divide-slate-100 text-xs">
							<table class="w-full text-left">
								<thead class="sticky top-0 bg-slate-100/95 text-[11px] text-slate-500 uppercase font-semibold">
									<tr>
										<th class="py-2 px-4">Deputāts</th>
										<th class="py-2 px-4 text-center">Frakcija</th>
										<th class="py-2 px-4 text-right">Lēmums</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-slate-100">
									for _, seat := range props.Seats {
										<tr class="hover:bg-slate-50/80 transition">
											<td class="py-2 px-4 font-medium text-slate-900">
												<a href={ templ.SafeURL(fmt.Sprintf("/deputati/%s/", seat.Slug)) } class="hover:text-emerald-700 hover:underline">
													{ seat.Name }
												</a>
											</td>
											<td class="py-2 px-4 text-center">
												<span
													class="inline-flex rounded px-1.5 py-0.5 font-mono text-[10px] font-bold text-white"
													style={ fmt.Sprintf("background-color: %s", seat.FactionColor) }
												>
													{ seat.FactionShort }
												</span>
											</td>
											<td class="py-2 px-4 text-right">
												<span
													class="inline-flex rounded px-2 py-0.5 text-[11px] font-bold"
													style={ fmt.Sprintf("color: %s", seat.Color) }
												>
													{ DecisionLabel(seat.Decision) }
												</span>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}

				<!-- External Protocols -->
				if props.Vote.ProtocolURL != "" {
					<div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
						<span>Oficiālie dokumenti:</span>
						<a
							href={ templ.SafeURL(props.Vote.ProtocolURL) }
							target="_blank"
							rel="noopener noreferrer"
							class="text-emerald-800 hover:underline font-medium"
						>
							Saeimas balsošanas protokols (saeima.lv) →
						</a>
					</div>
				}
			</article>
		</div>
	}
}
