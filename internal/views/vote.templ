package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/data"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ Vote(props VoteProps) {
	@Layout(props.LayoutProps) {
		{{ isDecision := IsDecisionProject(props.Vote.BillNumber) }}
		<article class="max-w-3xl mx-auto space-y-8">
			<!-- Breadcrumb & Copy Link -->
			<div class="flex flex-wrap items-center justify-between gap-3 text-xs text-neutral-600">
				<nav class="flex flex-wrap items-center gap-1.5" aria-label="Navigācijas ceļš">
					<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, "/")) } class="hover:text-neutral-950 hover:underline underline-offset-2 transition">← Visi balsojumi</a>
					if props.Vote.BillNumber != "" {
						<span class="text-neutral-400" aria-hidden="true">/</span>
						<a
							href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/likumprojekti/%s/", stats.CleanBillSlug(props.Vote.BillNumber)))) }
							class="tabular-nums hover:text-neutral-950 hover:underline underline-offset-2 transition"
						>
							if isDecision {
								Lēmuma projekts Nr. { CleanBillNr(props.Vote.BillNumber) }
							} else {
								Likumprojekts Nr. { CleanBillNr(props.Vote.BillNumber) }
							}
						</a>
					}
				</nav>
				<button
					type="button"
					id="copy-link-btn"
					class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-600 hover:text-neutral-950 transition cursor-pointer"
					title="Kopēt saiti uz šo balsojumu"
				>
					<svg class="w-3.5 h-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
					<span id="copy-link-text" aria-live="polite">Kopēt saiti</span>
				</button>
			</div>

			<!-- Article Header -->
			<header class="space-y-4">
				<!-- Section Eyebrow -->
				{{ stageLabel := DisplayReadingStage(*props.Vote) }}
				<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-neutral-600">
					if stageLabel != "" {
						<span class="font-semibold uppercase tracking-wider text-neutral-900 text-[11px]">{ stageLabel }</span>
					}
					if props.Vote.Category.Label != "" {
						<span>{ props.Vote.Category.Label }</span>
					}
					if props.Vote.IsUrgent {
						<span class="font-semibold uppercase tracking-wider text-amber-800 text-[11px]">Steidzams</span>
					}
					if props.Vote.IsSecret {
						<span class="font-medium text-neutral-600">Aizklāts balsojums</span>
					}
				</div>

				<!-- Serif Headline -->
				<h1 class="font-serif text-3xl sm:text-[38px] font-semibold tracking-[-0.015em] text-neutral-950 leading-[1.16]">
					{ VoteHeadline(*props.Vote) }
				</h1>

				if !IsSameTitle(props.Vote.OfficialTitle, props.Vote.SimplifiedTitle) {
					<p class="text-sm text-neutral-600 leading-relaxed italic">
						Oficiālais nosaukums: { props.Vote.OfficialTitle }
					</p>
				}

				<!-- Lead / Civic Purpose -->
				{{
					meaningfulPurpose := MeaningfulVotePurpose(props.Vote.Purpose)
					meaningfulSummary := MeaningfulVoteSummary(props.Vote.Summary)
					leadText := meaningfulPurpose
					if leadText == "" {
						leadText = meaningfulSummary
					}
				}}
				if leadText != "" {
					<p class="text-base sm:text-[17px] text-neutral-700 leading-relaxed">
						{ leadText }
					</p>
				}

				<!-- Editorial Dateline & Organic Inline Official Sources -->
				<div class="pt-1 space-y-1.5 text-xs text-neutral-600">
					<div class="flex flex-wrap items-center gap-x-2 gap-y-1 tabular-nums">
						<span class="font-medium text-neutral-900">{ FormatLatvianDateLong(props.Vote.SittingDate) }</span>
						if props.Vote.SittingTime != "" {
							<span>plkst. { props.Vote.SittingTime }</span>
						}
						{{ metaLabel, metaVal := ExtractSubmitterOrCommittee(props.Vote.Summary) }}
						if metaVal != "" && !strings.Contains(strings.ToLower(leadText), strings.ToLower(metaVal)) {
							<span class="text-neutral-300" aria-hidden="true">·</span>
							<span>{ metaLabel }: { metaVal }</span>
						}
					</div>
					<p class="leading-relaxed">
						Oficiālie Saeimas dokumenti:
						<a
							href={ templ.SafeURL(VoteProtocolURLFromPtr(props.Vote)) }
							target="_blank"
							rel="noopener noreferrer"
							class="text-neutral-900 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition ml-1"
						>
							balsošanas protokols ↗
						</a>
						if props.Vote.StenogramURL != "" {
							<span>, </span>
							<a
								href={ templ.SafeURL(props.Vote.StenogramURL) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-neutral-900 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition"
							>
								sēdes stenogramma ↗
							</a>
						}
						if props.Vote.BillURL != "" || props.Vote.BillNumber != "" {
							<span>, </span>
							<a
								href={ templ.SafeURL(VoteBillURL(props.Vote, ActiveTermNumber(props.LayoutProps))) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-neutral-900 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition"
							>
								if props.Vote.BillNumber != "" {
									if isDecision {
										lēmuma projekta Nr. { CleanBillNr(props.Vote.BillNumber) } karte ↗
									} else {
										likumprojekta Nr. { CleanBillNr(props.Vote.BillNumber) } karte ↗
									}
								} else {
									likumprojekta reģistrs ↗
								}
							</a>
						}
					</p>
				</div>
			</header>

			<!-- Verdict & Vote Tally Strip -->
			{{
				isConstAmend := IsConstitutionalAmendmentVote(props.Vote)
				quorumReq := VoteQuorumThreshold(props.Vote)
				totalCast := props.Vote.Counts.Par + props.Vote.Counts.Pret + props.Vote.Counts.Atturas + props.Vote.Counts.Nebalso
				if totalCast == 0 {
					totalCast = 100
				}
				parPct := float64(props.Vote.Counts.Par) * 100.0 / float64(totalCast)
				pretPct := float64(props.Vote.Counts.Pret) * 100.0 / float64(totalCast)
				attPct := float64(props.Vote.Counts.Atturas) * 100.0 / float64(totalCast)
				nebPct := float64(props.Vote.Counts.Nebalso) * 100.0 / float64(totalCast)
			}}
			<section class="border-y border-neutral-200 py-5 space-y-4">
				<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
					<div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 tabular-nums">
						<span class={ "text-xs font-bold uppercase tracking-widest " + ResultTextClass(props.Vote.Result) }>
							{ ResultLabel(props.Vote.Result) }
						</span>
						<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
							<span>
								<strong class="font-serif text-2xl font-bold text-emerald-800">{ fmt.Sprint(props.Vote.Counts.Par) }</strong>
								<span class="text-xs text-neutral-600 ml-1">Par</span>
							</span>
							<span>
								<strong class="font-serif text-2xl font-bold text-rose-800">{ fmt.Sprint(props.Vote.Counts.Pret) }</strong>
								<span class="text-xs text-neutral-600 ml-1">Pret</span>
							</span>
							<span>
								<strong class="font-serif text-2xl font-bold text-amber-800">{ fmt.Sprint(props.Vote.Counts.Atturas) }</strong>
								<span class="text-xs text-neutral-600 ml-1">Atturas</span>
							</span>
							<span>
								<strong class="font-serif text-2xl font-bold text-neutral-600">{ fmt.Sprint(props.Vote.Counts.Nebalso) }</strong>
								<span class="text-xs text-neutral-600 ml-1">Nebalsoja</span>
							</span>
						</div>
					</div>

					<div class="text-xs text-neutral-600 tabular-nums">
						<span>Piedalījās <strong class="text-neutral-900 font-semibold">{ fmt.Sprint(props.Vote.Counts.TotalPresent) }</strong></span>
						<span class="mx-1.5 text-neutral-300" aria-hidden="true">·</span>
						if props.Vote.Counts.TotalPresent >= quorumReq {
							<span class="text-emerald-800 font-medium">Kvorums sasniegts ({ fmt.Sprint(props.Vote.Counts.TotalPresent) }/{ fmt.Sprint(quorumReq) })</span>
						} else {
							<span class="text-amber-800 font-medium">Nav kvoruma ({ fmt.Sprint(props.Vote.Counts.TotalPresent) }/{ fmt.Sprint(quorumReq) })</span>
						}
					</div>
				</div>

				<!-- Clean Proportional Bar -->
				<div class="w-full h-2 bg-neutral-100 overflow-hidden flex">
					if parPct > 0 {
						<div style={ fmt.Sprintf("width: %.1f%%", parPct) } class="bg-emerald-700 h-full" title={ fmt.Sprintf("Par: %d (%.1f%%)", props.Vote.Counts.Par, parPct) }></div>
					}
					if pretPct > 0 {
						<div style={ fmt.Sprintf("width: %.1f%%", pretPct) } class="bg-rose-700 h-full" title={ fmt.Sprintf("Pret: %d (%.1f%%)", props.Vote.Counts.Pret, pretPct) }></div>
					}
					if attPct > 0 {
						<div style={ fmt.Sprintf("width: %.1f%%", attPct) } class="bg-amber-600 h-full" title={ fmt.Sprintf("Atturas: %d (%.1f%%)", props.Vote.Counts.Atturas, attPct) }></div>
					}
					if nebPct > 0 {
						<div style={ fmt.Sprintf("width: %.1f%%", nebPct) } class="bg-neutral-300 h-full" title={ fmt.Sprintf("Nebalsoja: %d (%.1f%%)", props.Vote.Counts.Nebalso, nebPct) }></div>
					}
				</div>

				<!-- Subtle Collapsible Constitutional Procedure Note -->
				<details class="group text-xs text-neutral-600">
					<summary class="cursor-pointer select-none font-medium text-neutral-600 hover:text-neutral-950 transition list-none inline-flex items-center gap-1.5">
						<span>
							if isConstAmend {
								Kā tiek noteikts rezultāts? (Satversmes 76. pants)
							} else {
								Kā tiek noteikts rezultāts? (Satversmes 24. pants)
							}
						</span>
						<span class="text-[10px] text-neutral-500 group-open:rotate-180 transition-transform" aria-hidden="true">▾</span>
					</summary>
					<p class="mt-2 text-xs text-neutral-600 leading-relaxed pl-3 border-l-2 border-neutral-200">
						if isConstAmend {
							if props.Vote.Result == "PIENEMTS" {
								Saskaņā ar Satversmes 76. pantu grozījumiem Satversmē nepieciešama vismaz divu trešdaļu deputātu klātbūtne (kvorums: 67) un vismaz <em>divu trešdaļu klātesošo deputātu balsu vairākums</em>. Piedalījās { FormatDeputiesCount(props.Vote.Counts.TotalPresent) }, un <strong>Par</strong> balsoja { fmt.Sprint(props.Vote.Counts.Par) }.
							} else if props.Vote.Result == "NAV_KVORUMA" {
								Saskaņā ar Satversmes 76. pantu balsojumā par Satversmes grozījumiem jāpiedalās vismaz divām trešdaļām Saeimas locekļu (67). Piedalījās tikai { fmt.Sprint(props.Vote.Counts.TotalPresent) }, tādēļ lēmums nav spēkā.
							} else {
								Saskaņā ar Satversmes 76. pantu nepieciešams vismaz divu trešdaļu klātesošo deputātu atbalsts, taču <strong>Par</strong> balsoja tikai { fmt.Sprint(props.Vote.Counts.Par) } no { fmt.Sprint(props.Vote.Counts.TotalPresent) } klātesošajiem.
							}
						} else if props.Vote.Result == "PIENEMTS" {
							Saskaņā ar Satversmes 24. pantu un Saeimas kārtības rulli parastie lēmumi tiek pieņemti ar <em>klātesošo deputātu vienkāršu balsu vairākumu</em> (kvorums: vismaz 50 balsotāji). Balsošanā piedalījās { FormatDeputiesCount(props.Vote.Counts.TotalPresent) }, un <strong>Par ({ fmt.Sprint(props.Vote.Counts.Par) })</strong> bija vairāk nekā <strong>Pret un Atturas ({ fmt.Sprint(props.Vote.Counts.Pret + props.Vote.Counts.Atturas) })</strong>.
						} else if props.Vote.Result == "NAV_KVORUMA" {
							Saskaņā ar Satversmes 24. pantu balsojumā jāpiedalās vismaz pusei Saeimas deputātu (50). Piedalījās tikai { fmt.Sprint(props.Vote.Counts.TotalPresent) }, tādēļ lēmums nav spēkā.
						} else {
							Balsojumā Par nodoto balsu skaits ({ fmt.Sprint(props.Vote.Counts.Par) }) nebija lielāks par Pret un Atturas kopskaitu ({ fmt.Sprint(props.Vote.Counts.Pret + props.Vote.Counts.Atturas) }).
						}
					</p>
				</details>
			</section>

			<!-- Faction Breakdown -->
			{{ stanceGroups := GroupFactionDecisions(props.Vote.FactionBreakdown) }}
			if len(stanceGroups) > 0 && !props.Vote.IsSecret {
				<section class="space-y-3">
					<h2 class="font-serif text-xl font-semibold text-neutral-950">
						Kā balsoja frakcijas
					</h2>
					<div class="divide-y divide-neutral-100 border-t border-neutral-200">
						for _, sg := range stanceGroups {
							<div class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-1.5 sm:gap-5 text-sm">
								<span class={ "w-24 shrink-0 text-[11px] font-bold uppercase tracking-wider " + DecisionBadgeClass(sg.Decision) }>
									{ sg.Decision }
								</span>
								<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-neutral-800">
									for _, f := range sg.Factions {
										<span class="whitespace-nowrap">
											<span class="font-medium">{ f.ShortName }</span>
											<span class="text-neutral-600 tabular-nums ml-0.5 text-xs">({ fmt.Sprint(f.Count) })</span>
										</span>
									}
								</div>
							</div>
						}
					</div>

					{{
						type devItem struct {
							mp     data.DeviatingMP
							fShort string
						}
						var devItems []devItem
						for _, fb := range props.Vote.FactionBreakdown {
							for _, d := range fb.DeviatingMps {
								devItems = append(devItems, devItem{mp: d, fShort: fb.ShortName})
							}
						}
					}}
					if len(devItems) > 0 {
						<p class="pt-1 text-xs text-neutral-600 leading-relaxed">
							<span class="font-semibold text-neutral-800">✦ Novirzes no frakcijas ({ fmt.Sprint(len(devItems)) }): </span>
							for i, item := range devItems {
								<a
									href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/deputati/%s/", ResolveMPSlug(props.Store, item.mp.MpID)))) }
									class="text-neutral-900 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 transition"
								>
									{ item.mp.Name }
								</a>
								<span class="text-neutral-600"> ({ item.fShort } { strings.ToLower(DecisionLabel(item.mp.Decision)) })</span>
								if i < len(devItems)-1 {
									<span class="text-neutral-400" aria-hidden="true"> · </span>
								}
							}
						</p>
					}
				</section>
			}

			<!-- Bill Progression Timeline -->
			if props.Timeline != nil && len(props.Timeline.Stages) > 0 {
				<section class="border-t border-neutral-200 pt-7 space-y-3">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<h2 class="font-serif text-xl font-semibold text-neutral-950">
							if isDecision {
								Lēmuma projekta Nr. { CleanBillNr(props.Vote.BillNumber) } gaita
							} else {
								Likumprojekta Nr. { CleanBillNr(props.Vote.BillNumber) } gaita
							}
							<span class="font-sans text-xs font-normal text-neutral-600 ml-1.5 whitespace-nowrap">({ FormatVotesCount(props.Timeline.TotalVotes) })</span>
						</h2>
						<a
							href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/likumprojekti/%s/", props.Timeline.Slug))) }
							class="text-xs font-medium text-neutral-600 hover:text-neutral-950 underline underline-offset-4 decoration-neutral-400 hover:decoration-neutral-950 transition"
						>
							Skatīt pilno gaitu →
						</a>
					</div>

					{{ compactEntries, totalTimelineVotes := CompactTimelineVotes(props.Timeline, props.Vote.ID, 12) }}
					<div class="divide-y divide-neutral-100 border-t border-neutral-200">
						for _, entry := range compactEntries {
							{{
								sv := entry.Vote
								isCurrent := sv.ID == props.Vote.ID
							}}
							<div class={ "py-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 sm:gap-4 text-sm", templ.KV("border-l-2 border-neutral-950 pl-3 sm:-ml-3", isCurrent) }>
								<div class="min-w-0 flex-1 space-y-0.5">
									<div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-neutral-600 tabular-nums">
										<span>{ FormatLatvianDate(sv.SittingDate) }</span>
										<span class="text-neutral-300" aria-hidden="true">|</span>
										<span class="font-medium text-neutral-800">{ entry.StageName }</span>
										if isCurrent {
											<span class="text-[10px] font-bold uppercase tracking-wider text-neutral-950">· Šis balsojums</span>
										}
									</div>
									if isCurrent {
										<div class="font-medium text-neutral-950 leading-snug">
											{ VoteHeadline(*sv) }
										</div>
									} else {
										<a
											href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", sv.ID))) }
											class="text-neutral-700 hover:text-neutral-950 hover:underline underline-offset-2 leading-snug block"
										>
											{ VoteHeadline(*sv) }
										</a>
									}
								</div>
								<div class="flex items-center gap-2.5 shrink-0 text-xs tabular-nums">
									<span class={ "font-semibold uppercase tracking-wider text-[11px] " + ResultTextClass(sv.Result) }>
										{ ResultLabel(sv.Result) }
									</span>
									<span class="text-neutral-600">
										{ fmt.Sprint(sv.Counts.Par) } : { fmt.Sprint(sv.Counts.Pret) }
									</span>
								</div>
							</div>
						}
						if totalTimelineVotes > len(compactEntries) {
							<div class="pt-3 text-xs">
								<a
									href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/likumprojekti/%s/", props.Timeline.Slug))) }
									class="font-medium text-neutral-700 hover:text-neutral-950 underline underline-offset-4 transition"
								>
									{ FormatAllBillVotesLink(totalTimelineVotes) }
								</a>
							</div>
						}
					</div>
				</section>
			}

			<!-- Sēdes Debates -->
			{{ orderedDebs := OrderedDebaters(props.Vote.DebateArguments) }}
			if len(orderedDebs) > 0 {
				<section class="debate-section border-t border-neutral-200 pt-7 space-y-5">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<h2 class="font-serif text-xl font-semibold text-neutral-950">
							Sēdes debates
							<span class="font-sans text-xs font-normal text-neutral-600 ml-1.5">({ FormatSpeakersCount(len(orderedDebs)) })</span>
						</h2>
						if props.Vote.StenogramURL != "" {
							<a
								href={ templ.SafeURL(props.Vote.StenogramURL) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-xs font-medium text-neutral-600 hover:text-neutral-950 underline underline-offset-4 decoration-neutral-400 hover:decoration-neutral-950 transition"
							>
								Pilna stenogramma saeima.lv ↗
							</a>
						}
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						for _, deb := range orderedDebs {
							{{
								st := DebaterStyle(deb)
								mpSlug := ResolveMPSlugByName(props.Store, deb.Name)
							}}
							<div class={ "debate-card flex flex-col justify-between space-y-2 " + st.CardClass }>
								<div class="space-y-1.5">
									<div class="flex flex-wrap items-baseline justify-between gap-1.5">
										<div class={ "text-sm font-semibold " + st.TitleClass }>
											<span class="text-xs font-normal text-neutral-600 mr-1">{ st.PrefixLabel }</span>
											if mpSlug != "" {
												<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/deputati/%s/", mpSlug))) } class="hover:underline underline-offset-2">
													{ deb.Name }
												</a>
											} else {
												<span>{ deb.Name }</span>
											}
											if deb.Fraction != "" {
												<span class="font-normal text-neutral-600 text-xs ml-1">({ deb.Fraction })</span>
											}
										</div>
										if st.VotePillText != "" {
											<span class={ "text-[11px] font-semibold uppercase tracking-wider shrink-0 " + st.VotePillClass }>
												{ st.VotePillText }
											</span>
										}
									</div>
									if st.MetaSubtitle != "" {
										<div class="text-xs text-neutral-600">
											{ st.MetaSubtitle }
										</div>
									}
									<div class="text-sm text-neutral-700 leading-relaxed">
										if st.HasRealSpeech {
											<p class="debate-preview font-serif italic text-[15px]">„{ deb.Preview }“</p>
											if st.CanExpand {
												<div class="debate-full hidden max-h-72 overflow-y-auto pr-2 text-neutral-800 space-y-2 text-sm">
													for _, para := range SpeechParagraphs(deb.FullSpeech) {
														<p>{ para }</p>
													}
												</div>
											}
										} else {
											<p class="text-xs text-neutral-600">
												Stenogrammas teksts vēl tiek sagatavots.
											</p>
										}
									</div>
								</div>
								if st.CanExpand {
									<div class="pt-1">
										<button
											type="button"
											aria-expanded="false"
											class={ "debate-toggle-btn cursor-pointer text-xs font-medium inline-flex items-center gap-1 select-none " + st.BtnClass }
										>
											<span class="debate-btn-text">Lasīt pilno runu</span>
											<span class="debate-arrow text-[10px]" aria-hidden="true">↓</span>
										</button>
									</div>
								}
							</div>
						}
					</div>
				</section>
			}

			<!-- Hemicycle & Rollcall Section -->
			if props.Vote.IsSecret {
				<section class="border-t border-neutral-200 pt-7 space-y-2">
					<h2 class="font-serif text-xl font-semibold text-neutral-950">Aizklāts balsojums</h2>
					<p class="text-sm text-neutral-600 leading-relaxed">
						Saskaņā ar Satversmi un Saeimas kārtības rulli amatpersonu vēlēšanās individuālie deputātu balsojumi netiek fiksēti un nav publiski pieejami.
					</p>
				</section>
			} else {
				<section class="border-t border-neutral-200 pt-7 space-y-5">
					<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
						<h2 class="font-serif text-xl font-semibold text-neutral-950">
							Saeimas sēžu zāle
							<span class="font-sans text-xs font-normal text-neutral-600 ml-1.5">({ FormatSeatsCount(len(props.Seats)) })</span>
						</h2>
						<div class="flex flex-wrap items-center gap-1.5 text-xs" id="hemicycle-filter-group" role="group" aria-label="Filtrēt sēdvietas pēc balsojuma">
							<button
								type="button"
								data-filter-decision="ALL"
								aria-pressed="true"
								class="px-2.5 py-1 font-semibold text-xs transition border border-neutral-950 bg-neutral-950 text-white cursor-pointer tabular-nums"
							>
								Visi ({ fmt.Sprint(len(props.Seats)) })
							</button>
							<button
								type="button"
								data-filter-decision="PAR"
								aria-pressed="false"
								class="px-2.5 py-1 font-medium text-xs text-neutral-700 bg-white border border-neutral-200 hover:border-neutral-950 transition inline-flex items-center gap-1.5 cursor-pointer tabular-nums"
							>
								<span class="w-2 h-2 rounded-full bg-emerald-700" aria-hidden="true"></span>
								<span>Par ({ fmt.Sprint(props.Vote.Counts.Par) })</span>
							</button>
							<button
								type="button"
								data-filter-decision="PRET"
								aria-pressed="false"
								class="px-2.5 py-1 font-medium text-xs text-neutral-700 bg-white border border-neutral-200 hover:border-neutral-950 transition inline-flex items-center gap-1.5 cursor-pointer tabular-nums"
							>
								<span class="w-2 h-2 rounded-full bg-rose-700" aria-hidden="true"></span>
								<span>Pret ({ fmt.Sprint(props.Vote.Counts.Pret) })</span>
							</button>
							if props.Vote.Counts.Atturas > 0 {
								<button
									type="button"
									data-filter-decision="ATTURAS"
									aria-pressed="false"
									class="px-2.5 py-1 font-medium text-xs text-neutral-700 bg-white border border-neutral-200 hover:border-neutral-950 transition inline-flex items-center gap-1.5 cursor-pointer tabular-nums"
								>
									<span class="w-2 h-2 rounded-full bg-amber-600" aria-hidden="true"></span>
									<span>Atturas ({ fmt.Sprint(props.Vote.Counts.Atturas) })</span>
								</button>
							}
							if props.Vote.Counts.Nebalso > 0 {
								<button
									type="button"
									data-filter-decision="NEBALSO"
									aria-pressed="false"
									class="px-2.5 py-1 font-medium text-xs text-neutral-700 bg-white border border-neutral-200 hover:border-neutral-950 transition inline-flex items-center gap-1.5 cursor-pointer tabular-nums"
								>
									<span class="w-2 h-2 rounded-full bg-neutral-500" aria-hidden="true"></span>
									<span>Nebalsoja ({ fmt.Sprint(props.Vote.Counts.Nebalso) })</span>
								</button>
							}
						</div>
					</div>

					<!-- Accessible Pre-rendered SVG Hemicycle -->
					<div class="relative w-full aspect-[640/310] max-w-2xl mx-auto py-2" data-hemicycle-container data-factions={ FactionsCompactJSON(props.Store) }>
						<div
							id="seat-tooltip"
							class="absolute z-30 -translate-x-1/2 -translate-y-full opacity-0 pointer-events-none transition-opacity duration-75 ease-out shadow-md border border-neutral-200 bg-white px-3 py-2 text-xs min-w-[170px] max-w-[calc(100%-12px)]"
							role="tooltip"
						>
							<div class="flex items-center justify-between gap-2 pb-1 border-b border-neutral-100">
								<span class="font-semibold text-neutral-950 truncate" data-tooltip-name>Deputāts</span>
								<span
									class="inline-flex px-1.5 py-0.5 text-[10px] font-bold leading-none shrink-0"
									data-tooltip-faction
								>
									JV
								</span>
							</div>
							<div class="flex items-center justify-between pt-1 text-[11px]">
								<span class="text-neutral-600">Balsojums:</span>
								<span class="font-bold" data-tooltip-decision>PAR</span>
							</div>
							<div data-tooltip-caret class="absolute left-1/2 -bottom-1 -translate-x-1/2 w-2 h-2 bg-white border-r border-b border-neutral-200 rotate-45"></div>
						</div>

						<svg viewBox="0 0 640 310" class="hc w-full h-full select-none" role="group" aria-label="Saeimas sēžu zāles balsojums">
							for _, seat := range props.Seats {
								<a
									href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/deputati/%s/", seat.Slug))) }
									aria-label={ fmt.Sprintf("%s (%s): %s", seat.Name, seat.FactionShort, DecisionLabel(seat.Decision)) }
									data-f={ seat.FactionID }
									data-d={ seat.Decision }
									if seat.IsDeviating {
										data-dev={ seat.FactionLine }
									}
								>
									<circle cx={ fmt.Sprintf("%.1f", seat.X) } cy={ fmt.Sprintf("%.1f", seat.Y) } r="8">
										<title>{ fmt.Sprintf("%s (%s): %s", seat.Name, seat.FactionShort, DecisionLabel(seat.Decision)) }</title>
									</circle>
								</a>
							}
						</svg>
					</div>

					<!-- Off-screen accessible plain seat list for screen readers & no-JS fallback (AGENTS.md §3) -->
					<ul class="sr-only" aria-label="Deputātu balsojumu saraksts">
						for _, seat := range props.Seats {
							<li>{ fmt.Sprintf("%s (%s): %s", seat.Name, seat.FactionShort, DecisionLabel(seat.Decision)) }</li>
						}
					</ul>

					<p class="text-xs text-neutral-600 text-center">
						Noklikšķiniet uz sēdvietas, lai skatītu deputāta profilu, vai izmantojiet tabulu zemāk.
					</p>
				</section>

				<!-- Rollcall Audit Table -->
				<section class="border-t border-neutral-200 pt-7 space-y-4">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
						<div class="flex items-baseline gap-2.5 whitespace-nowrap shrink-0">
							<h2 class="font-serif text-xl font-semibold text-neutral-950">Deputātu balsojumi</h2>
							<span id="deputy-visible-count" aria-live="polite" class="text-xs text-neutral-600 tabular-nums">
								{ FormatDeputiesCount(len(props.Seats)) }
							</span>
						</div>

						<div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 min-w-0">
							if props.Store != nil && len(props.Store.Factions) > 0 {
								<select
									id="deputy-faction-filter"
									aria-label="Filtrēt deputātus pēc frakcijas"
									class="border border-neutral-300 bg-white py-1.5 px-2.5 text-xs text-neutral-800 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer max-w-[190px] truncate"
								>
									<option value="ALL">Visas frakcijas</option>
									for _, f := range props.Store.Factions {
										<option value={ f.ShortName }>{ f.ShortName } — { f.Name }</option>
									}
								</select>
							}
							<div class="relative flex-1 sm:w-44">
								<svg class="absolute left-0 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-neutral-500" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
								<label for="deputy-search-input" class="sr-only">Meklēt deputātu balsojumu tabulā</label>
								<input
									type="text"
									id="deputy-search-input"
									aria-label="Meklēt deputātu balsojumu tabulā"
									placeholder="Meklēt deputātu..."
									class="w-full border-0 border-b border-neutral-300 bg-transparent py-1.5 pl-5 pr-2 text-xs text-neutral-950 placeholder:text-neutral-500 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950"
								/>
							</div>
						</div>
					</div>

					<div class="overflow-x-auto max-h-[540px] overflow-y-auto border-t border-neutral-950">
						<table class="w-full text-left text-sm border-collapse table-fixed">
							<colgroup>
								<col class="w-[48%] sm:w-[44%]"/>
								<col class="w-[18%] sm:w-[38%]"/>
								<col class="w-[34%] sm:w-[18%]"/>
							</colgroup>
							<thead class="sticky top-0 z-10 bg-white border-b border-neutral-200 text-[10px] sm:text-[11px] font-semibold uppercase tracking-normal sm:tracking-wider text-neutral-600">
								<tr>
									<th scope="col" class="py-2.5 px-1.5 sm:px-3" data-sort="name" aria-sort="none">
										<button type="button" class="inline-flex items-center gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap">
											<span>Deputāts</span>
											<span class="sort-icon text-neutral-500 text-[10px]" aria-hidden="true">↕</span>
										</button>
									</th>
									<th scope="col" class="py-2.5 px-1 sm:px-3" data-sort="faction" aria-sort="none">
										<button type="button" class="inline-flex items-center gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap">
											<span class="hidden sm:inline">Frakcija</span>
											<abbr title="Frakcija" class="sm:hidden no-underline">Frakc.</abbr>
											<span class="sort-icon text-neutral-500 text-[10px]" aria-hidden="true">↕</span>
										</button>
									</th>
									<th scope="col" class="py-2.5 px-1.5 sm:px-3 text-right" data-sort="decision" aria-sort="none">
										<button type="button" class="inline-flex items-center justify-end gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap ml-auto">
											<span>Balsojums</span>
											<span class="sort-icon text-neutral-500 text-[10px]" aria-hidden="true">↕</span>
										</button>
									</th>
								</tr>
							</thead>
							<tbody id="rollcall-table-body" class="divide-y divide-neutral-100">
								<tr id="rollcall-empty-row" class="hidden">
									<td colspan="3" class="py-10 text-center text-neutral-600 text-xs">
										Nav atrasts neviens deputāts pēc izvēlētajiem filtriem.
									</td>
								</tr>
							</tbody>
						</table>
						<noscript>
							<p class="p-4 text-center text-xs text-neutral-600">
								Interaktīvai meklēšanai un kārtošanai nepieciešams JavaScript. Visi deputātu balsojumi ir pieejami sēžu zāles kartē un pieejamības sarakstā augstāk.
							</p>
						</noscript>
					</div>
				</section>
			}

			<script src="/assets/js/hemicycle-tooltip.js"></script>
		</article>
	}
}
