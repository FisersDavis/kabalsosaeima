package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ MPView(props MPProps) {
	@Layout(props.LayoutProps) {
		{{
			color := "#737373"
			fShort := props.MP.FactionID
			fName := "Pie frakcijām nepiederošs deputāts"
			if props.Faction != nil {
				if props.Faction.Color != "" {
					color = props.Faction.Color
				}
				if props.Faction.ShortName != "" {
					fShort = props.Faction.ShortName
				}
				if props.Faction.Name != "" {
					fName = props.Faction.Name
				}
			}

			isMandateCurrentlyActive := false
			if props.Mandate != nil && len(props.Mandate.Active) > 0 {
				last := props.Mandate.Active[len(props.Mandate.Active)-1]
				if last.To == nil || *last.To == "" {
					isMandateCurrentlyActive = true
				}
			}

			termNum := ActiveTermNumber(props.LayoutProps)
			officialURL := ""
			if props.Mandate != nil && props.Mandate.Source != "" {
				officialURL = props.Mandate.Source
			} else if props.MP.SaeimaID != "" {
				officialURL = fmt.Sprintf("https://www.saeima.lv/lv/sasaukumi/%d-saeima/deputati/%s/", termNum, props.MP.SaeimaID)
			}
		}}
		<article class="max-w-3xl mx-auto space-y-8">
			<!-- Breadcrumb Navigation -->
			<nav class="flex flex-wrap items-center gap-1.5 text-xs text-neutral-500">
				<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, "/")) } class="hover:text-neutral-950 hover:underline underline-offset-2 transition">← Visi balsojumi</a>
				<span class="text-neutral-300">/</span>
				<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, "/deputati/")) } class="hover:text-neutral-950 hover:underline underline-offset-2 transition">Deputāti</a>
				<span class="text-neutral-300">/</span>
				<span class="text-neutral-900 font-medium">{ props.MP.Name }</span>
			</nav>

			<!-- Editorial Dossier Header -->
			<header class="space-y-3">
				<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-neutral-500">
					<span class="inline-flex items-center gap-1.5 font-semibold text-neutral-900">
						<span class="w-2 h-2 rounded-full shrink-0" style={ fmt.Sprintf("background-color: %s;", color) }></span>
						<span>{ fShort }</span>
					</span>
					<span class="text-neutral-300">|</span>
					<span>{ fName }</span>
					if props.MP.SeatNumber > 0 {
						<span class="text-neutral-300">|</span>
						<span class="tabular-nums">Sēdvieta Nr. { fmt.Sprint(props.MP.SeatNumber) }</span>
					}
				</div>

				<h1 class="font-serif text-3xl sm:text-[40px] font-semibold tracking-[-0.015em] text-neutral-950 leading-tight">
					{ props.MP.Name }
				</h1>

				<!-- Mandate Status & Organic Inline Official Source Links -->
				<div class="space-y-1.5 text-xs text-neutral-600">
					<div class="flex flex-wrap items-center gap-2">
						if !isMandateCurrentlyActive || !props.MP.IsActive {
							<span class="inline-flex items-center gap-1.5 font-medium text-neutral-700">
								<span class="w-1.5 h-1.5 rounded-full bg-neutral-400"></span>
								if props.Mandate != nil && props.Mandate.Note != "" {
									<span>Mandāts neaktīvs ({ props.Mandate.Note })</span>
								} else {
									<span>Mandāts neaktīvs</span>
								}
							</span>
						} else {
							<span class="inline-flex items-center gap-1.5 font-medium text-emerald-800">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-700"></span>
								<span>{ fmt.Sprintf("Aktīvs %d. Saeimas deputāta mandāts", termNum) }</span>
							</span>
						}
					</div>
					<p class="text-neutral-500">
						Oficiālie Saeimas avoti:
						if officialURL != "" {
							<a
								href={ templ.SafeURL(officialURL) }
								target="_blank"
								rel="noopener noreferrer"
								class="text-neutral-800 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition ml-1"
							>
								deputāta dosjē saeima.lv ↗
							</a>
							<span>, </span>
						}
						<a
							href={ templ.SafeURL(SaeimaDeputiesRegistryURL(termNum)) }
							target="_blank"
							rel="noopener noreferrer"
							class="text-neutral-800 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition ml-1"
						>
							{ fmt.Sprintf("%d. Saeimas deputātu reģistrs ↗", termNum) }
						</a>
					</p>
				</div>
			</header>

			<!-- Key Parliamentary Figures (Clean 2-Column Editorial Strip, Zero BI Boxes) -->
			<section class="border-y border-neutral-200 py-6 grid grid-cols-1 md:grid-cols-2 gap-8 md:divide-x md:divide-neutral-200">
				<!-- Attendance -->
				<div class="space-y-3">
					<div class="text-[11px] font-semibold uppercase tracking-wider text-neutral-500">
						Klātbūtnes rādītājs
					</div>
					<div class="flex items-baseline gap-2.5 tabular-nums">
						<span class="font-serif text-4xl font-bold text-neutral-950">
							{ FormatPct(props.Attendance.PresentPct) }%
						</span>
						<span class="text-xs text-neutral-500">
							{ fmt.Sprint(props.Attendance.PresentCount) } no { fmt.Sprint(props.Attendance.TotalEligibleVotes) } tiesīgiem balsojumiem
						</span>
					</div>

					<div class="w-full h-1.5 bg-neutral-100 overflow-hidden flex">
						if props.Attendance.PresentPct > 0 {
							<div style={ fmt.Sprintf("width: %.1f%%", props.Attendance.PresentPct) } class="bg-emerald-700 h-full"></div>
						}
						if props.Attendance.WithheldPct > 0 {
							<div style={ fmt.Sprintf("width: %.1f%%", props.Attendance.WithheldPct) } class="bg-amber-600 h-full"></div>
						}
						if props.Attendance.AbsentPct > 0 {
							<div style={ fmt.Sprintf("width: %.1f%%", props.Attendance.AbsentPct) } class="bg-neutral-300 h-full"></div>
						}
					</div>

					<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-600 tabular-nums">
						<span>Aktīvi balsojis: <strong class="font-semibold text-neutral-900">{ fmt.Sprint(props.Attendance.PresentCount) }</strong></span>
						<span class="text-neutral-300">·</span>
						<span>Kvoruma manevri: <strong class="font-semibold text-neutral-900">{ fmt.Sprint(props.Attendance.WithheldCount) }</strong></span>
						<span class="text-neutral-300">·</span>
						<span>Prombūtnē: <strong class="font-semibold text-neutral-900">{ fmt.Sprint(props.Attendance.AbsentCount) }</strong></span>
					</div>

					<p class="text-xs text-neutral-500 leading-relaxed">
						Rēķināts tikai par balsojumiem deputāta aktīvā mandāta laikā.
					</p>
				</div>

				<!-- Faction Cohesion -->
				<div class="space-y-3 md:pl-8">
					<div class="text-[11px] font-semibold uppercase tracking-wider text-neutral-500">
						Balsojumu sakritība ar partiju
					</div>
					if props.Cohesion.IsIndependent {
						<div class="font-serif text-2xl font-semibold text-neutral-900">
							Neatkarīgais deputāts
						</div>
						<p class="text-xs text-neutral-500 leading-relaxed">
							Deputāts nepieder pie frakcijas, tāpēc partijas balsojumu sakritība netiek rēķināta.
						</p>
					} else {
						<div class="flex items-baseline gap-2.5 tabular-nums">
							<span class="font-serif text-4xl font-bold text-neutral-950">
								if props.Cohesion.CohesionPct != nil {
									{ FormatPct(*props.Cohesion.CohesionPct) }%
								} else {
									100%
								}
							</span>
							<span class="text-xs text-neutral-500">
								saskaņā ar frakcijas vairākumu
							</span>
						</div>

						<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-600 tabular-nums pt-2">
							<span>Vienoti: <strong class="font-semibold text-neutral-900">{ fmt.Sprint(props.Cohesion.ActiveAlignedCount) }</strong></span>
							<span class="text-neutral-300">·</span>
							<span>Pretēji: <strong class="font-semibold text-rose-800">{ fmt.Sprint(props.Cohesion.OppositeCount) }</strong></span>
							<span class="text-neutral-300">·</span>
							<span>Toņa nianses: <strong class="font-semibold text-amber-800">{ fmt.Sprint(props.Cohesion.NuanceCount) }</strong></span>
						</div>

						<p class="text-xs text-neutral-500 leading-relaxed">
							Salīdzināts ar deputāta faktiskās frakcijas vairākuma nostāju katra balsojuma dienā.
						</p>
					}
				</div>
			</section>

			<!-- Deviations List -->
			if len(props.Cohesion.Deviations) > 0 {
				<section class="space-y-3">
					<h2 class="font-serif text-xl font-semibold text-neutral-950">
						Novirzes no frakcijas vairākuma
						<span class="font-sans text-xs font-normal text-neutral-500 ml-1.5">({ fmt.Sprint(len(props.Cohesion.Deviations)) })</span>
					</h2>
					<div class="divide-y divide-neutral-200 border-t border-neutral-200">
						for _, dev := range props.Cohesion.Deviations {
							{{
								voteObj := props.Store.VoteByID[dev.VoteID]
								title := dev.VoteID
								if voteObj != nil {
									title = CleanVoteTitle(voteObj.SimplifiedTitle)
								}
							}}
							<div class="py-3.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 text-sm">
								<div class="min-w-0 flex-1 space-y-0.5">
									<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", dev.VoteID))) } class="font-medium text-neutral-950 hover:underline underline-offset-2 leading-snug block">
										{ title }
									</a>
									<div class="text-xs text-neutral-500 tabular-nums">
										<span>{ FormatLatvianDate(dev.SittingDate) }</span>
										if dev.DeviationType == stats.DeviationOpposite {
											<span class="mx-1.5 text-neutral-300">·</span>
											<span class="text-rose-800 font-medium">Atklāta pretruna</span>
										} else {
											<span class="mx-1.5 text-neutral-300">·</span>
											<span class="text-amber-800 font-medium">Toņa atšķirība (Pret vs Atturas)</span>
										}
									</div>
								</div>
								<div class="flex items-center gap-1.5 text-xs shrink-0 tabular-nums">
									<span class="font-bold uppercase tracking-wider" style={ fmt.Sprintf("color: %s", DecisionColor(dev.Decision)) }>
										{ DecisionLabel(dev.Decision) }
									</span>
									<span class="text-neutral-400">pret</span>
									<span class="font-semibold uppercase tracking-wider" style={ fmt.Sprintf("color: %s", DecisionColor(dev.FactionLine)) }>
										{ DecisionLabel(dev.FactionLine) }
									</span>
									<span class="text-neutral-400">(frakcija)</span>
								</div>
							</div>
						}
					</div>
				</section>
			}

			<!-- Chronological Voting History -->
			<section class="border-t border-neutral-200 pt-7 space-y-4">
				{{
					maxHistoryRows := 200
					visibleHistory := props.History
					if len(visibleHistory) > maxHistoryRows {
						visibleHistory = visibleHistory[:maxHistoryRows]
					}
				}}
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div class="flex items-baseline gap-2">
						<h2 class="font-serif text-xl font-semibold text-neutral-950">
							Balsojumu vēsture
						</h2>
						<span class="text-xs text-neutral-500 tabular-nums">
							{ FormatVotesCount(len(props.History)) }
							if len(props.History) > maxHistoryRows {
								<span> · jaunākie { fmt.Sprint(maxHistoryRows) }</span>
							}
						</span>
					</div>

					if len(props.History) > 0 {
						<div class="flex items-center gap-2.5">
							<select
								id="mp-history-decision"
								class="border border-neutral-300 bg-white py-1.5 px-2.5 text-xs text-neutral-800 focus:border-neutral-950 focus:outline-none cursor-pointer"
							>
								<option value="ALL">Visi lēmumi</option>
								<option value="PAR">Par</option>
								<option value="PRET">Pret</option>
								<option value="ATTURAS">Atturas</option>
								<option value="NEBALSO">Nebalsoja</option>
							</select>
							<input
								type="text"
								id="mp-history-search"
								placeholder="Meklēt balsojumu..."
								class="w-44 sm:w-52 border-0 border-b border-neutral-300 bg-transparent py-1.5 px-1 text-xs text-neutral-950 placeholder:text-neutral-400 focus:border-neutral-950 focus:outline-none"
							/>
						</div>
					}
				</div>

				<div class="divide-y divide-neutral-100 border-t border-neutral-950 max-h-[540px] overflow-y-auto">
					for _, h := range visibleHistory {
						{{
							voteObj := props.Store.VoteByID[h.VoteID]
							title := h.VoteID
							result := ""
							if voteObj != nil {
								title = CleanVoteTitle(voteObj.SimplifiedTitle)
								result = ResultLabel(voteObj.Result)
							}
						}}
						<div
							class="mp-history-row py-3 flex items-baseline justify-between gap-4 hover:bg-neutral-50 transition"
							data-title={ strings.ToLower(title + " " + h.SittingDate) }
							data-decision={ strings.ToUpper(h.Record.Decision) }
						>
							<div class="min-w-0 flex-1 space-y-0.5">
								<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", h.VoteID))) } class="text-sm font-medium text-neutral-950 hover:underline underline-offset-2 leading-snug block">
									{ title }
								</a>
								<div class="text-xs text-neutral-500 tabular-nums">
									<span>{ FormatLatvianDate(h.SittingDate) }</span>
									if result != "" {
										<span class="mx-1.5 text-neutral-300">·</span>
										<span>{ result }</span>
									}
								</div>
							</div>

							<div class="shrink-0 text-right">
								<span
									class="text-[11px] font-bold uppercase tracking-wider tabular-nums"
									style={ fmt.Sprintf("color: %s", DecisionColor(h.Record.Decision)) }
								>
									{ DecisionLabel(h.Record.Decision) }
								</span>
							</div>
						</div>
					}
					<div id="mp-history-empty" class="hidden py-10 text-center text-neutral-400 text-xs">
						Nav atrasts neviens balsojums pēc izvēlētā filtra.
					</div>
				</div>
				<script src="/assets/js/mp-filter.js"></script>
			</section>
		</article>
	}
}
