package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ MPView(props MPProps) {
	@Layout(props.LayoutProps) {
		<div class="space-y-6">
			<!-- Breadcrumb Navigation -->
			<nav class="flex items-center gap-2 text-xs text-slate-500">
				<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, "/")) } class="hover:text-slate-900 hover:underline transition">← Visi balsojumi</a>
				<span>/</span>
				<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, "/deputati/")) } class="hover:text-slate-900 hover:underline transition">Deputāti</a>
				<span>/</span>
				<span class="text-slate-900 font-semibold">{ props.MP.Name }</span>
			</nav>

			<!-- Profile Header Card -->
			<section class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6 shadow-2xs space-y-4">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
					<div class="flex items-center gap-4">
						<!-- Avatar Circle -->
						{{
							color := "#64748B"
							fShort := props.MP.FactionID
							fName := "Neatkarīgais deputāts"
							if props.Faction != nil {
								if props.Faction.Color != "" {
									color = props.Faction.Color
								}
								if props.Faction.ShortName != "" {
									fShort = props.Faction.ShortName
								}
								if props.Faction.Name != "" {
									fName = props.Faction.Name
								}
							}
							textColor := FactionTextColor(props.MP.FactionID, "")
							if props.Faction != nil {
								textColor = FactionTextColor(props.MP.FactionID, props.Faction.TextColor)
							}
							initials := ""
							parts := strings.Fields(props.MP.Name)
							if len(parts) >= 2 {
								initials = string([]rune(parts[0])[0:1]) + string([]rune(parts[len(parts)-1])[0:1])
							} else if len(props.MP.Name) > 0 {
								initials = string([]rune(props.MP.Name)[0:1])
							}
						}}
						<div
							class="w-14 h-14 rounded-full flex items-center justify-center font-bold text-lg shadow-xs shrink-0"
							style={ fmt.Sprintf("background-color: %s; color: %s;", color, textColor) }
						>
							{ strings.ToUpper(initials) }
						</div>

						<div class="space-y-1">
							<div class="flex flex-wrap items-center gap-2">
								<h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900">
									{ props.MP.Name }
								</h1>
								<span
									class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold shadow-2xs"
									style={ fmt.Sprintf("background-color: %s; color: %s;", color, textColor) }
								>
									{ fShort }
								</span>
							</div>

							<div class="flex flex-wrap items-center gap-2 text-xs text-slate-600">
								<span>{ fName }</span>
								<span class="text-slate-300">·</span>
								<span class="font-mono text-slate-500">Sēdvieta Nr. { fmt.Sprint(props.MP.SeatNumber) }</span>
							</div>
						</div>
					</div>

					<!-- Mandate Status Badge -->
					<div class="self-stretch sm:self-auto">
						{{
							isMandateCurrentlyActive := false
							if props.Mandate != nil && len(props.Mandate.Active) > 0 {
								last := props.Mandate.Active[len(props.Mandate.Active)-1]
								if last.To == nil || *last.To == "" {
									isMandateCurrentlyActive = true
								}
							}
						}}
						if !isMandateCurrentlyActive || !props.MP.IsActive {
							<div class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 border border-slate-200">
								<span class="w-2 h-2 rounded-full bg-slate-400"></span>
								if props.Mandate != nil && props.Mandate.Note != "" {
									<span>Mandāts neaktīvs ({ props.Mandate.Note })</span>
								} else {
									<span>Mandāts neaktīvs</span>
								}
							</div>
						} else {
							<div class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-800 border border-emerald-200">
								<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
								<span>{ fmt.Sprintf("Aktīvs %d. Saeimas deputāta mandāts", ActiveTermNumber(props.LayoutProps)) }</span>
							</div>
						}
					</div>
				</div>
			</section>

			<!-- Honest Attendance Section -->
			<section class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6 shadow-2xs space-y-4">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
					<div>
						<div class="text-xs uppercase font-semibold text-slate-400">
							Klātbūtnes rādītājs
						</div>
						<div class="mt-1 flex items-baseline gap-2">
							<span class="text-3xl font-extrabold text-slate-900 font-mono">
								{ FormatPct(props.Attendance.PresentPct) } %
							</span>
							<span class="text-xs text-slate-500">
								(kopā { fmt.Sprint(props.Attendance.TotalEligibleVotes) } tiesīgos balsojumos)
							</span>
						</div>
						<p class="text-xs text-slate-500 mt-1 leading-relaxed max-w-lg">
							Aprēķināts godīgi — tikai par tiem sēžu balsojumiem, kuros deputātam bija spēkā aktīvs mandāts.
						</p>
					</div>

					<div class="grid grid-cols-3 gap-2 sm:gap-3 text-center self-stretch sm:self-auto">
						<div class="p-2 sm:p-2.5 rounded-lg bg-emerald-50/70 border border-emerald-100">
							<div class="text-sm sm:text-base font-mono font-bold text-emerald-700">
								{ fmt.Sprint(props.Attendance.PresentCount) }
							</div>
							<div class="text-[10px] text-emerald-800 font-medium">
								Aktīvi balsojis
							</div>
						</div>
						<div class="p-2 sm:p-2.5 rounded-lg bg-amber-50/70 border border-amber-100">
							<div class="text-sm sm:text-base font-mono font-bold text-amber-700">
								{ fmt.Sprint(props.Attendance.WithheldCount) }
							</div>
							<div class="text-[10px] text-amber-800 font-medium">
								Kvoruma manevri
							</div>
						</div>
						<div class="p-2 sm:p-2.5 rounded-lg bg-slate-50 border border-slate-200">
							<div class="text-sm sm:text-base font-mono font-bold text-slate-700">
								{ fmt.Sprint(props.Attendance.AbsentCount) }
							</div>
							<div class="text-[10px] text-slate-600 font-medium">
								Prombūtnē
							</div>
						</div>
					</div>
				</div>

				<!-- 3-Segment Stacked Bar -->
				<div class="space-y-1.5 pt-2">
					<div class="h-3 w-full bg-slate-100 rounded-full overflow-hidden flex shadow-inner">
						if props.Attendance.PresentPct > 0 {
							<div style={ fmt.Sprintf("width: %.1f%%", props.Attendance.PresentPct) } class="bg-emerald-500 h-full"></div>
						}
						if props.Attendance.WithheldPct > 0 {
							<div style={ fmt.Sprintf("width: %.1f%%", props.Attendance.WithheldPct) } class="bg-amber-400 h-full"></div>
						}
						if props.Attendance.AbsentPct > 0 {
							<div style={ fmt.Sprintf("width: %.1f%%", props.Attendance.AbsentPct) } class="bg-slate-300 h-full"></div>
						}
					</div>
					<div class="flex items-center justify-between text-[11px] text-slate-500 font-mono">
						<span>Aktīvi: { FormatPct(props.Attendance.PresentPct) }%</span>
						<span>Kvoruma manevri: { FormatPct(props.Attendance.WithheldPct) }%</span>
						<span>Prombūtnē: { FormatPct(props.Attendance.AbsentPct) }%</span>
					</div>
				</div>

				<div class="rounded-lg bg-slate-50 p-3 text-[11px] text-slate-600 leading-relaxed border border-slate-100">
					<strong class="text-slate-800">Kāpēc deputāti dažkārt nebalso?</strong> Saskaņā ar Satversmes 24. pantu Saeima var lemt, ja sēdē piedalās vismaz 50 deputāti (kvorums). Reģistrēšanās zālē, bet apzināta atturēšanās nospiest pogu ir parlamentārs instruments kvoruma noraušanai.
				</div>
			</section>

			<!-- Faction Cohesion Section -->
			<section class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6 shadow-2xs space-y-4">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
					<div>
						<div class="text-xs uppercase font-semibold text-slate-400">
							Balsojumu sakritība ar partiju
						</div>
						if props.Cohesion.IsIndependent {
							<div class="mt-1 text-sm font-bold text-slate-700">
								Neatkarīgais deputāts
							</div>
							<p class="text-xs text-slate-500 mt-0.5">
								Deputāts nepieder pie frakcijas, tāpēc partijas balsojumu sakritība netiek rēķināta.
							</p>
						} else {
							<div class="mt-1 flex items-baseline gap-2">
								<span class="text-3xl font-extrabold text-slate-900 font-mono">
									if props.Cohesion.CohesionPct != nil {
										{ FormatPct(*props.Cohesion.CohesionPct) } %
									} else {
										100 %
									}
								</span>
								<span class="text-xs text-slate-500">
									(saskaņā ar frakcijas vairākumu)
								</span>
							</div>
							<p class="text-xs text-slate-500 mt-1 leading-relaxed max-w-lg">
								Aprēķināts no aktīvi nodotajām balsīm, salīdzinot ar frakcijas vairākuma nostāju konkrētajā balsojumā.
							</p>
						}
					</div>

					if !props.Cohesion.IsIndependent {
						<div class="grid grid-cols-3 gap-2 sm:gap-3 text-center self-stretch sm:self-auto">
							<div class="p-2 sm:p-2.5 rounded-lg bg-emerald-50/70 border border-emerald-100">
								<div class="text-sm sm:text-base font-mono font-bold text-emerald-700">
									{ fmt.Sprint(props.Cohesion.ActiveAlignedCount) }
								</div>
								<div class="text-[10px] text-slate-500 font-medium">
									Vienoti
								</div>
							</div>
							<div class="p-2 sm:p-2.5 rounded-lg bg-rose-50/70 border border-rose-100">
								<div class="text-sm sm:text-base font-mono font-bold text-rose-700">
									{ fmt.Sprint(props.Cohesion.OppositeCount) }
								</div>
								<div class="text-[10px] text-rose-700 font-medium">
									Pretēji
								</div>
							</div>
							<div class="p-2 sm:p-2.5 rounded-lg bg-amber-50/70 border border-amber-100">
								<div class="text-sm sm:text-base font-mono font-bold text-amber-700">
									{ fmt.Sprint(props.Cohesion.NuanceCount) }
								</div>
								<div class="text-[10px] text-amber-700 font-medium">
									Toņa nianses
								</div>
							</div>
						</div>
					}
				</div>

				<!-- Deviations List -->
				if len(props.Cohesion.Deviations) > 0 {
					<div class="rounded-lg border border-slate-200 overflow-hidden divide-y divide-slate-100 text-xs">
						<div class="px-4 py-2.5 bg-slate-50 font-semibold text-slate-700">
							Novirzes no frakcijas vairākuma ({ fmt.Sprint(len(props.Cohesion.Deviations)) })
						</div>
						for _, dev := range props.Cohesion.Deviations {
							{{
								voteObj := props.Store.VoteByID[dev.VoteID]
								title := dev.VoteID
								if voteObj != nil {
									title = CleanVoteTitle(voteObj.SimplifiedTitle)
								}
							}}
							<div class="p-3.5 flex items-center justify-between gap-3 hover:bg-slate-50/60 transition">
								<div class="min-w-0 flex-1">
									<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", dev.VoteID))) } class="font-bold text-slate-900 hover:text-emerald-700 transition">
										{ title }
									</a>
									<div class="text-[11px] text-slate-500 font-mono mt-0.5">
										{ dev.SittingDate }
										if dev.DeviationType == stats.DeviationOpposite {
											<span class="ml-1 text-rose-700 font-semibold font-sans">· Atklāta pretruna</span>
										} else {
											<span class="ml-1 text-amber-700 font-semibold font-sans">· Toņa atšķirība (Pret vs Atturas)</span>
										}
									</div>
								</div>
								<div class="flex items-center gap-2 text-right shrink-0">
									<span class="font-mono text-xs font-bold" style={ fmt.Sprintf("color: %s", DecisionColor(dev.Decision)) }>
										{ DecisionLabel(dev.Decision) }
									</span>
									<span class="text-slate-400">vs</span>
									<span class="font-mono text-xs font-semibold" style={ fmt.Sprintf("color: %s", DecisionColor(dev.FactionLine)) }>
										{ DecisionLabel(dev.FactionLine) } (frakcija)
									</span>
								</div>
							</div>
						}
					</div>
				}
			</section>

			<!-- Historical Votes Section -->
			<section class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs space-y-0">
				{{
					maxHistoryRows := 200
					visibleHistory := props.History
					if len(visibleHistory) > maxHistoryRows {
						visibleHistory = visibleHistory[:maxHistoryRows]
					}
				}}
				<div class="px-5 py-3.5 bg-slate-50/90 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
					<div class="flex items-center gap-2">
						<h2 class="text-sm font-bold text-slate-900">
							Balsojumu vēsture ({ fmt.Sprint(len(props.History)) } balsojumi)
						</h2>
						if len(props.History) > maxHistoryRows {
							<span class="text-[11px] text-slate-500 font-mono">
								· jaunākie { fmt.Sprint(maxHistoryRows) }
							</span>
						}
					</div>
					if len(props.History) > 0 {
						<div class="flex items-center gap-2">
							<select
								id="mp-history-decision"
								class="rounded-lg border border-slate-200 bg-white py-1 px-2 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer shadow-2xs"
							>
								<option value="ALL">Visi lēmumi</option>
								<option value="PAR">Par</option>
								<option value="PRET">Pret</option>
								<option value="ATTURAS">Atturas</option>
								<option value="NEBALSO">Nebalsoja</option>
							</select>
							<input
								type="text"
								id="mp-history-search"
								placeholder="Meklēt balsojumu..."
								class="w-40 sm:w-52 rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-400 shadow-2xs"
							/>
						</div>
					}
				</div>

				<div class="divide-y divide-slate-100 max-h-96 overflow-y-auto text-xs">
					for _, h := range visibleHistory {
						{{
							voteObj := props.Store.VoteByID[h.VoteID]
							title := h.VoteID
							result := ""
							if voteObj != nil {
								title = CleanVoteTitle(voteObj.SimplifiedTitle)
								result = ResultLabel(voteObj.Result)
							}
						}}
						<div
							class="mp-history-row p-3.5 flex items-center justify-between gap-3 hover:bg-slate-50/60 transition"
							data-title={ strings.ToLower(title + " " + h.SittingDate) }
							data-decision={ strings.ToUpper(h.Record.Decision) }
						>
							<div class="min-w-0 flex-1">
								<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", h.VoteID))) } class="font-bold text-slate-900 hover:text-emerald-700 transition">
									{ title }
								</a>
								<div class="text-[11px] text-slate-500 font-mono mt-0.5">
									{ h.SittingDate }
									if result != "" {
										<span>· { result }</span>
									}
								</div>
							</div>

							<div class="shrink-0 text-right">
								<span
									class="inline-flex rounded px-2 py-0.5 text-[11px] font-bold"
									style={ fmt.Sprintf("color: %s", DecisionColor(h.Record.Decision)) }
								>
									{ DecisionLabel(h.Record.Decision) }
								</span>
							</div>
						</div>
					}
					<div id="mp-history-empty" class="hidden p-8 text-center text-slate-400 text-xs">
						Nav atrasts neviens balsojums pēc izvēlētā filtra.
					</div>
				</div>
				<script src="/assets/js/mp-filter.js"></script>
			</section>

			<!-- Official Verification & Data Sources Section -->
			<section class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6 shadow-2xs space-y-3">
				<div class="flex items-center justify-between text-xs">
					<span class="font-bold text-slate-900 flex items-center gap-1.5">
						<svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
						</svg>
						<span>Oficiālie datu avoti un caurskatāmība</span>
					</span>
					<span class="text-[11px] text-slate-400">Avots: Latvijas Republikas Saeima</span>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
					{{
						termNum := ActiveTermNumber(props.LayoutProps)
						officialURL := ""
						if props.Mandate != nil && props.Mandate.Source != "" {
							officialURL = props.Mandate.Source
						} else if props.MP.SaeimaID != "" {
							officialURL = fmt.Sprintf("https://www.saeima.lv/lv/sasaukumi/%d-saeima/deputati/%s/", termNum, props.MP.SaeimaID)
						}
					}}
					if officialURL != "" {
						<a
							href={ templ.SafeURL(officialURL) }
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-start gap-2.5 p-3 rounded-lg border border-slate-200 bg-slate-50/70 hover:bg-slate-100 hover:border-slate-300 transition group"
						>
							<span class="text-base leading-none">🏛️</span>
							<div class="min-w-0 flex-1">
								<div class="font-semibold text-slate-900 group-hover:text-emerald-800 flex items-center gap-1">
									<span>Oficiālais Saeimas deputāta dosjē</span>
									<svg class="w-3 h-3 text-slate-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 02 2h10a2 2 0 0 02-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
								</div>
								<p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1">
									Biogrāfija, mandāta vēsture, amati komisijās un debašu runas (saeima.lv)
								</p>
							</div>
						</a>
					}

					<a
						href={ templ.SafeURL(SaeimaDeputiesRegistryURL(termNum)) }
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-start gap-2.5 p-3 rounded-lg border border-slate-200 bg-slate-50/70 hover:bg-slate-100 hover:border-slate-300 transition group"
					>
						<span class="text-base leading-none">📋</span>
						<div class="min-w-0 flex-1">
							<div class="font-semibold text-slate-900 group-hover:text-blue-800 flex items-center gap-1">
								<span>{ fmt.Sprintf("%d. Saeimas deputātu reģistrs", termNum) }</span>
								<svg class="w-3 h-3 text-slate-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 02 2h10a2 2 0 0 02-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
							</div>
							<p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1">
								Latvijas Republikas Saeimas oficiālais deputātu un frakciju sastāvs (saeima.lv)
							</p>
						</div>
					</a>
				</div>
			</section>
		</div>
	}
}
