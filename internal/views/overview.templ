package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/data"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ Overview(props OverviewProps) {
	@Layout(props.LayoutProps) {
		<div class="space-y-4">
			<!-- Filter Toolbar -->
			<section class="sticky top-[57px] z-30 rounded-xl bg-white/95 p-3 shadow-2xs backdrop-blur-md border border-slate-200 space-y-2.5">
				<!-- Search Row & Filtri Toggle Button -->
				<div class="flex items-center gap-2">
					<div class="relative flex-1">
						<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<input
							type="text"
							id="filter-search"
							placeholder="Meklēt likumu vai atslēgvārdu..."
							class="w-full rounded-lg border border-slate-200 bg-white py-1.5 pl-9 pr-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-400 shadow-2xs"
						/>
					</div>

					<button
						type="button"
						id="filter-toggle-btn"
						aria-expanded="false"
						aria-controls="filter-panel"
						class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700 shadow-2xs transition cursor-pointer shrink-0"
					>
						<svg class="h-3.5 w-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
						</svg>
						<span>Filtri</span>
						<span id="filter-badge" class="hidden rounded-full bg-slate-900 px-1.5 py-0.2 text-[10px] font-bold text-white">0</span>
					</button>

					<button
						type="button"
						id="filter-reset"
						class="hidden inline-flex items-center rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition cursor-pointer whitespace-nowrap shrink-0"
					>
						Notīrīt
					</button>
				</div>

				<!-- Collapsible Filter Drawer containing Gala lēmumi, Stage, Category, Outcome -->
				<div id="filter-panel" class="hidden pt-2 border-t border-slate-100 flex flex-wrap items-center gap-2">
					<!-- Tier 1 Segmented Switch -->
					<div class="inline-flex rounded-lg bg-slate-100 p-0.5 border border-slate-200 text-xs font-medium shadow-2xs shrink-0">
						<button
							type="button"
							id="filter-tier1"
							data-active="false"
							class="rounded-md px-2.5 py-1 transition cursor-pointer font-medium bg-white text-slate-700 shadow-2xs hover:text-slate-900"
						>
							Gala lēmumi (3. lasījums)
						</button>
					</div>

					<!-- Stage / Vote Type -->
					<select
						id="filter-stage"
						class="rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
					>
						<option value="ALL">Visi balsojumi</option>
						<option value="likums">Likumu pieņemšana</option>
						<option value="priekslikums">Priekšlikumi un grozījumi</option>
						<option value="procedura">Procedūra un darba kārtība</option>
					</select>

					<!-- Category / Topic -->
					<select
						id="filter-category"
						class="rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
					>
						<option value="ALL">Visi temati</option>
						for _, cat := range props.Categories {
							<option value={ cat.ID }>{ cat.Label }</option>
						}
					</select>

					<!-- Outcome -->
					<select
						id="filter-outcome"
						class="rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
					>
						<option value="ALL">Visi rezultāti</option>
						<option value="PIENEMTS">Pieņemtie</option>
						<option value="NORAIDITS">Noraidītie</option>
						<option value="NAV_KVORUMA">Nav kvoruma</option>
					</select>
				</div>

				<div class="flex items-center justify-between text-[11px] text-slate-400 pt-0.5">
					<span id="filter-count" class="font-mono">
						Atrasti { fmt.Sprint(len(props.Votes)) } balsojumi
					</span>
				</div>
			</section>

			<!-- Vote Cards Feed -->
			<section class="space-y-3.5">
				for _, v := range props.Votes {
					<article
						class="vote-card rounded-xl border border-slate-200 bg-white p-4 shadow-2xs transition hover:border-slate-300 hover:shadow-xs space-y-2.5"
						data-title={ strings.ToLower(fmt.Sprintf("%s %s %s %s", v.SimplifiedTitle, v.OfficialTitle, v.BillNumber, v.Summary)) }
						data-category={ v.Category.ID }
						data-stage={ v.VoteType }
						data-outcome={ v.Result }
						data-tier1={ fmt.Sprintf("%t", IsFinalReadingVote(v)) }
					>
						<!-- Metadata Eyebrow -->
						<div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 font-medium tracking-wide">
							<span class="font-mono text-slate-500">{ v.SittingDate }</span>

							if v.ReadingStage != "" && v.ReadingStage != "Darba kārtība" && v.ReadingStage != "Procedūra" {
								<span>·</span>
								<span class="uppercase tracking-wider text-slate-600 text-[10px] font-semibold">{ v.ReadingStage }</span>
							}

							if v.BillNumber != "" {
								<span>·</span>
								<a
									href={ templ.SafeURL(fmt.Sprintf("/likumprojekti/%s/", stats.CleanBillSlug(v.BillNumber))) }
									class="font-mono text-slate-500 hover:text-emerald-700 hover:underline"
									title="Skatīt likumprojekta gaitu"
								>
									Nr. { CleanBillNr(v.BillNumber) }
								</a>
							}

							if v.Category.Label != "" {
								<span>·</span>
								<span class="text-slate-500">{ v.Category.Label }</span>
							}

							if v.IsUrgent {
								<span>·</span>
								<span class="font-semibold text-amber-700 uppercase tracking-wider text-[10px]">Steidzams</span>
							}

							if v.IsSecret {
								<span>·</span>
								<span class="text-slate-500">Aizklāts balsojums</span>
							}
						</div>

						<!-- Title + Outcome Badge with score -->
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900">
								<a href={ templ.SafeURL(fmt.Sprintf("/balsojumi/%s/", v.ID)) } class="hover:text-emerald-700 transition">
									{ CleanVoteTitle(v.SimplifiedTitle) }
								</a>
							</h3>
							<span class={ "inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold shadow-2xs whitespace-nowrap shrink-0 " + ResultBadgeClass(v.Result) }>
								{ ResultLabel(v.Result) }
								if v.Counts.Par > 0 || v.Counts.Pret > 0 {
									<span class="font-mono ml-2 text-[11px] font-semibold opacity-90 tabular-nums">{ fmt.Sprint(v.Counts.Par) } : { fmt.Sprint(v.Counts.Pret) }</span>
								}
							</span>
						</div>

						<!-- Meaningful Civic Purpose (Editorial subheader without bureaucratic prefix) -->
						{{ meaningfulContext := MeaningfulVotePurpose(v.Purpose) }}
						if meaningfulContext != "" {
							<p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed border-l-2 border-slate-300 pl-3 py-0.5">
								{ meaningfulContext }
							</p>
						}

						<!-- Sēdes Debates (Adaptive: Single Spotlight vs 2-Column Duel) -->
						{{ keyDebs := KeyDebaters(v.DebateArguments) }}
						if len(keyDebs) > 0 {
							<div class="debate-section pt-1 space-y-2">
								if len(keyDebs) == 1 {
									{{ deb := keyDebs[0] }}
									{{
										isPar := strings.EqualFold(deb.Opinion, "Par")
										borderBg := "border-emerald-200/90 bg-emerald-50/50"
										dotColor := "bg-emerald-600"
										titleColor := "text-emerald-950"
										btnColor := "text-emerald-800 hover:text-emerald-950"
										opinionLabel := "Par"
										if !isPar {
											borderBg = "border-rose-200/90 bg-rose-50/50"
											dotColor = "bg-rose-600"
											titleColor = "text-rose-950"
											btnColor = "text-rose-800 hover:text-rose-950"
											opinionLabel = "Pret"
										}
									}}
									<div class={ "w-full rounded-lg border p-2.5 sm:p-3 transition flex flex-col justify-between " + borderBg }>
										<div class="space-y-1.5">
											<div class={ "flex items-center gap-1.5 text-xs font-bold " + titleColor }>
												<span class={ "inline-block w-2.5 h-2.5 rounded-full shrink-0 " + dotColor }></span>
												<span>Runāja "{ opinionLabel }": { deb.Name } ({ deb.Fraction })</span>
											</div>
											<div class="text-xs text-slate-700 leading-relaxed">
												<p class="debate-preview italic">„{ deb.Preview }“</p>
												if deb.FullSpeech != "" && deb.FullSpeech != deb.Preview {
													<div class="debate-full hidden max-h-52 overflow-y-auto pr-1 text-slate-800 space-y-1 font-normal not-italic">
														<p>„{ deb.FullSpeech }“</p>
													</div>
												}
											</div>
										</div>
										if deb.FullSpeech != "" && deb.FullSpeech != deb.Preview {
											<div class="pt-1.5">
												<button
													type="button"
													class={ "debate-toggle-btn cursor-pointer text-[11px] font-semibold inline-flex items-center gap-1 select-none " + btnColor }
												>
													<span class="debate-btn-text">Lasīt pilno runu</span>
													<span class="debate-arrow text-[10px]">↓</span>
												</button>
											</div>
										}
									</div>
								} else {
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
										for _, deb := range keyDebs {
											if strings.EqualFold(deb.Opinion, "Par") {
												<div class="rounded-lg border border-emerald-200/90 bg-emerald-50/50 p-2.5 sm:p-3 transition flex flex-col justify-between">
													<div class="space-y-1.5">
														<div class="flex items-center gap-1.5 text-xs font-bold text-emerald-950">
															<span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-600 shrink-0"></span>
															<span>Runāja "Par": { deb.Name } ({ deb.Fraction })</span>
														</div>
														<div class="text-xs text-slate-700 leading-relaxed">
															<p class="debate-preview italic">„{ deb.Preview }“</p>
															if deb.FullSpeech != "" && deb.FullSpeech != deb.Preview {
																<div class="debate-full hidden max-h-52 overflow-y-auto pr-1 text-slate-800 space-y-1 font-normal not-italic">
																	<p>„{ deb.FullSpeech }“</p>
																</div>
															}
														</div>
													</div>
													if deb.FullSpeech != "" && deb.FullSpeech != deb.Preview {
														<div class="pt-1.5">
															<button
																type="button"
																class="debate-toggle-btn cursor-pointer text-[11px] font-semibold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 select-none"
															>
																<span class="debate-btn-text">Lasīt pilno runu</span>
																<span class="debate-arrow text-[10px]">↓</span>
															</button>
														</div>
													}
												</div>
											} else {
												<div class="rounded-lg border border-rose-200/90 bg-rose-50/50 p-2.5 sm:p-3 transition flex flex-col justify-between">
													<div class="space-y-1.5">
														<div class="flex items-center gap-1.5 text-xs font-bold text-rose-950">
															<span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-600 shrink-0"></span>
															<span>Runāja "Pret": { deb.Name } ({ deb.Fraction })</span>
														</div>
														<div class="text-xs text-slate-700 leading-relaxed">
															<p class="debate-preview italic">„{ deb.Preview }“</p>
															if deb.FullSpeech != "" && deb.FullSpeech != deb.Preview {
																<div class="debate-full hidden max-h-52 overflow-y-auto pr-1 text-slate-800 space-y-1 font-normal not-italic">
																	<p>„{ deb.FullSpeech }“</p>
																</div>
															}
														</div>
													</div>
													if deb.FullSpeech != "" && deb.FullSpeech != deb.Preview {
														<div class="pt-1.5">
															<button
																type="button"
																class="debate-toggle-btn cursor-pointer text-[11px] font-semibold text-rose-800 hover:text-rose-950 inline-flex items-center gap-1 select-none"
															>
																<span class="debate-btn-text">Lasīt pilno runu</span>
																<span class="debate-arrow text-[10px]">↓</span>
															</button>
														</div>
													}
												</div>
											}
										}
									</div>
								}
								if len(v.DebateArguments.Debaters) > len(keyDebs) {
									<div class="text-right pt-0.5">
										<a
											href={ templ.SafeURL(fmt.Sprintf("/balsojumi/%s/", v.ID)) }
											class="text-[11px] font-medium text-slate-500 hover:text-emerald-700 hover:underline transition"
										>
											Skatīt visus { fmt.Sprint(len(v.DebateArguments.Debaters)) } debatētājus sēdes lapā →
										</a>
									</div>
								}
							</div>
						}

						<!-- Faction Breakdown Grouped by Stance (Side-by-side aligned with debate boxes) -->
						{{ stanceGroups := GroupFactionDecisions(v.FactionBreakdown) }}
						if len(stanceGroups) > 0 && !v.IsSecret {
							<div class="pt-2 border-t border-slate-100">
								<div class={ "text-xs", templ.KV("grid grid-cols-1 sm:grid-cols-2 gap-2.5", len(stanceGroups) > 1), templ.KV("w-full", len(stanceGroups) == 1) }>
									for _, sg := range stanceGroups {
										<div class="flex items-start gap-2 min-w-0">
											<span class={ "inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold border tracking-wider min-w-[50px] justify-center shrink-0 mt-0.5 " + DecisionBadgeClass(sg.Decision) }>
												{ sg.Decision }
											</span>
											<div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs leading-relaxed min-w-0">
												for i, f := range sg.Factions {
													<span class="text-slate-800 font-medium whitespace-nowrap">
														{ f.ShortName }
														<span class="text-slate-500 font-mono text-[11px]">({ fmt.Sprint(f.Count) })</span>
													</span>
													if i < len(sg.Factions)-1 {
														<span class="text-slate-300">·</span>
													}
												}
											</div>
										</div>
									}
								</div>
							</div>
						}

						<!-- Deviations Note (subtle) -->
						{{
							type devItem struct {
								mp   data.DeviatingMP
								fShort string
							}
							var devItems []devItem
							for _, fb := range v.FactionBreakdown {
								for _, d := range fb.DeviatingMps {
									devItems = append(devItems, devItem{mp: d, fShort: fb.ShortName})
								}
							}
						}}
						if len(devItems) > 0 {
							<div class="pt-1.5 border-t border-slate-100 text-[11px] text-slate-500">
								<span class="text-slate-600 font-medium">✦ Novirzes no frakcijas ({ fmt.Sprint(len(devItems)) }): </span>
								for i, item := range devItems {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/deputati/%s/", ResolveMPSlug(props.Store, item.mp.MpID))) }
										class="text-slate-700 hover:text-emerald-700 hover:underline transition"
									>
										{ item.mp.Name }
									</a>
									<span class="text-slate-400"> ({ item.fShort } { strings.ToLower(DecisionLabel(item.mp.Decision)) })</span>
									if i < len(devItems)-1 {
										<span class="text-slate-300"> · </span>
									}
								}
							</div>
						}

						<!-- Action Footer -->
						<div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs">
							<a
								href={ templ.SafeURL(fmt.Sprintf("/balsojumi/%s/", v.ID)) }
								class="inline-flex items-center gap-1.5 font-semibold text-emerald-800 hover:text-emerald-950 transition"
							>
								<span>Skatīt sēžu zāli un likumprojekta gaitu →</span>
							</a>
							<div class="flex items-center gap-1.5 sm:gap-2">
								<a
									href={ templ.SafeURL(VoteProtocolURL(v)) }
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 hover:text-emerald-800 transition underline underline-offset-2"
									title="Oficiālais Saeimas balsošanas protokols vai likumprojekta reģistrs"
								>
									<span>📄 Protokols</span>
									<svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
								</a>
								if v.StenogramURL != "" {
									<span class="text-slate-300">·</span>
									<a
										href={ templ.SafeURL(v.StenogramURL) }
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 hover:text-blue-800 transition underline underline-offset-2"
										title="Saeimas sēdes stenogramma un debates"
									>
										<span>🎙️ Stenogramma</span>
										<svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
									</a>
								}
							</div>
						</div>
					</article>
				}
			</section>

			<!-- Empty State -->
			<div id="filter-empty-state" class="hidden rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-500">
				<p class="text-sm font-semibold">Nav atrasts neviens balsojums</p>
				<p class="text-xs text-slate-400 mt-1">
					Pamēģiniet mainīt meklēšanas vārdu vai noņemt kādu no filtriem.
				</p>
				<button
					type="button"
					id="filter-empty-reset"
					class="mt-3.5 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 transition cursor-pointer"
				>
					Atiestatīt visus filtrus
				</button>
			</div>

			<!-- Filter Script -->
			<script src="/assets/js/filter.js"></script>
		</div>
	}
}
