package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/data"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ Overview(props OverviewProps) {
	@Layout(props.LayoutProps) {
		<div
			id="overview-feed-root"
			class="space-y-2"
			data-base-path={ props.LayoutProps.BasePath }
			data-total-pages={ fmt.Sprint(props.TotalPages) }
			data-total-votes={ fmt.Sprint(props.TotalVotes) }
			data-current-page={ fmt.Sprint(props.CurrentPage) }
		>
			<h1 class="sr-only">
				{ fmt.Sprintf("%d. Saeimas balsojumu arhīvs", ActiveTermNumber(props.LayoutProps)) }
			</h1>

			<!-- Editorial Search & Filter Strip (NYTimes-style, hairline separated) -->
			<section class="border-b border-neutral-200 pb-4 space-y-3">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div class="relative flex-1 max-w-xl">
						<svg class="absolute left-0 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-500" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<label for="filter-search" class="sr-only">Meklēt likumu, tēmu vai atslēgvārdu</label>
						<input
							type="text"
							id="filter-search"
							aria-label="Meklēt likumu, tēmu vai atslēgvārdu"
							placeholder="Meklēt likumu, tēmu vai atslēgvārdu..."
							class="w-full border-0 border-b border-neutral-300 bg-transparent py-2 pl-6 pr-2 text-sm text-neutral-950 placeholder:text-neutral-500 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 transition"
						/>
					</div>

					<div class="flex items-center justify-between sm:justify-end gap-3 text-xs">
						<span id="filter-count" aria-live="polite" class="text-neutral-600 tabular-nums">
							{ FormatVotesCount(len(props.Votes)) }
						</span>

						<div class="flex items-center gap-2">
							<button
								type="button"
								id="filter-toggle-btn"
								aria-expanded="false"
								aria-controls="filter-panel"
								class="inline-flex items-center gap-1.5 border border-neutral-300 bg-white hover:border-neutral-950 px-3 py-1.5 text-xs font-medium text-neutral-800 transition cursor-pointer shrink-0"
							>
								<span>Filtri</span>
								<span id="filter-badge" class="hidden rounded-full bg-neutral-950 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-white">0</span>
							</button>

							<button
								type="button"
								id="filter-reset"
								class="hidden text-xs font-medium text-neutral-600 hover:text-neutral-950 underline underline-offset-4 transition cursor-pointer whitespace-nowrap shrink-0"
							>
								Notīrīt
							</button>
						</div>
					</div>
				</div>

				<!-- Collapsible Filter Drawer -->
				<div id="filter-panel" class="hidden pt-3 border-t border-neutral-100 flex flex-wrap items-center gap-2.5">
					<button
						type="button"
						id="filter-tier1"
						data-active="false"
						aria-pressed="false"
						class="border border-neutral-300 bg-white px-3 py-1.5 text-xs font-medium text-neutral-700 hover:border-neutral-950 hover:text-neutral-950 transition cursor-pointer shrink-0"
					>
						Gala lēmumi (3. lasījums)
					</button>

					<select
						id="filter-stage"
						aria-label="Filtrēt pēc balsojuma veida"
						class="border border-neutral-300 bg-white py-1.5 px-2.5 text-xs text-neutral-800 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer"
					>
						<option value="ALL">Visi balsojumi</option>
						<option value="likums">Likumu pieņemšana</option>
						<option value="priekslikums">Priekšlikumi un grozījumi</option>
						<option value="procedura">Procedūra un darba kārtība</option>
					</select>

					<select
						id="filter-category"
						aria-label="Filtrēt pēc temata"
						class="border border-neutral-300 bg-white py-1.5 px-2.5 text-xs text-neutral-800 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer"
					>
						<option value="ALL">Visi temati</option>
						for _, cat := range props.Categories {
							<option value={ cat.ID }>{ cat.Label }</option>
						}
					</select>

					<select
						id="filter-outcome"
						aria-label="Filtrēt pēc rezultāta"
						class="border border-neutral-300 bg-white py-1.5 px-2.5 text-xs text-neutral-800 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer"
					>
						<option value="ALL">Visi rezultāti</option>
						<option value="PIENEMTS">Pieņemtie</option>
						<option value="NORAIDITS">Noraidītie</option>
						<option value="NAV_KVORUMA">Nav kvoruma</option>
					</select>
				</div>

				<div id="filter-archive-status" aria-live="polite" class="hidden text-xs font-medium text-emerald-800"></div>
			</section>

			<!-- Cross-page Full Archive Search Results -->
			<section id="filter-archive-results" class="hidden divide-y divide-neutral-200"></section>

			<!-- Editorial Vote Feed (NYTimes × LSM × Datan) -->
			<section id="static-vote-feed" class="divide-y divide-neutral-200">
				for _, v := range props.Votes {
					{{
						totalCast := v.Counts.Par + v.Counts.Pret + v.Counts.Atturas + v.Counts.Nebalso
						if totalCast == 0 {
							totalCast = 100
						}
						parPct := float64(v.Counts.Par) * 100.0 / float64(totalCast)
						pretPct := float64(v.Counts.Pret) * 100.0 / float64(totalCast)
						attPct := float64(v.Counts.Atturas) * 100.0 / float64(totalCast)
						nebPct := float64(v.Counts.Nebalso) * 100.0 / float64(totalCast)

						meaningfulContext := MeaningfulVotePurpose(v.Purpose)
						stageLabel := DisplayReadingStage(v)
						searchParts := []string{v.SimplifiedTitle}
						if !IsSameTitle(v.OfficialTitle, v.SimplifiedTitle) {
							searchParts = append(searchParts, v.OfficialTitle)
						}
						if v.BillNumber != "" {
							searchParts = append(searchParts, v.BillNumber)
						}
						if meaningfulContext != "" {
							searchParts = append(searchParts, meaningfulContext)
						} else if v.Summary != "" {
							searchParts = append(searchParts, v.Summary)
						}
						searchBlob := strings.ToLower(strings.Join(searchParts, " "))

						type devItem struct {
							mp     data.DeviatingMP
							fShort string
						}
						var devItems []devItem
						for _, fb := range v.FactionBreakdown {
							for _, d := range fb.DeviatingMps {
								devItems = append(devItems, devItem{mp: d, fShort: fb.ShortName})
							}
						}
					}}
					<article
						class="vote-card grid grid-cols-1 md:grid-cols-[120px_1fr_176px] gap-y-2 md:gap-x-7 py-6 transition"
						data-title={ searchBlob }
						data-category={ v.Category.ID }
						data-stage={ v.VoteType }
						data-outcome={ v.Result }
						data-tier1={ fmt.Sprintf("%t", IsFinalReadingVote(v)) }
					>
						<!-- Left Column: Date (Desktop) & Compact Date+Outcome Header (Mobile) -->
						<div class="flex items-center justify-between md:flex-col md:items-start md:justify-start md:pt-1 gap-2">
							<time class="text-xs text-neutral-600 tabular-nums whitespace-nowrap">
								{ FormatLatvianDate(v.SittingDate) }
							</time>
							<!-- Mobile-only compact outcome + tally -->
							<div class="flex md:hidden items-center gap-2 text-xs tabular-nums">
								<span class={ "font-semibold uppercase tracking-wider text-[11px] " + ResultTextClass(v.Result) }>
									{ ResultLabel(v.Result) }
								</span>
								if v.Counts.Par > 0 || v.Counts.Pret > 0 {
									<span class="text-neutral-800 font-semibold">{ fmt.Sprint(v.Counts.Par) } : { fmt.Sprint(v.Counts.Pret) }</span>
								}
							</div>
							if v.IsUrgent {
								<span class="hidden md:inline-block text-[10px] font-semibold uppercase tracking-wider text-amber-800 mt-1">
									Steidzams
								</span>
							}
							if v.IsSecret {
								<span class="hidden md:inline-block text-[10px] font-medium text-neutral-600 mt-1">
									Aizklāts balsojums
								</span>
							}
						</div>

						<!-- Center Column: Eyebrow + Serif Headline + 2-Line Summary -->
						<div class="min-w-0 space-y-2">
							<div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-[11px] text-neutral-600">
								if stageLabel != "" && stageLabel != "Darba kārtība" && stageLabel != "Procedūra" {
									<span class="font-semibold uppercase tracking-wider text-neutral-900">{ stageLabel }</span>
								} else if stageLabel != "" {
									<span class="font-medium uppercase tracking-wider text-neutral-600">{ stageLabel }</span>
								}
								if v.Category.Label != "" {
									<span class="whitespace-nowrap">{ v.Category.Label }</span>
								}
								if v.BillNumber != "" {
									<a
										href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/likumprojekti/%s/", stats.CleanBillSlug(v.BillNumber)))) }
										class="tabular-nums whitespace-nowrap hover:text-neutral-950 hover:underline underline-offset-2 transition"
										title="Skatīt likumprojekta gaitu"
									>
										Nr. { CleanBillNr(v.BillNumber) }
									</a>
								}
								if v.IsUrgent {
									<span class="md:hidden font-semibold uppercase tracking-wider text-amber-800 whitespace-nowrap">Steidzams</span>
								}
								if v.IsSecret {
									<span class="md:hidden font-medium text-neutral-600 whitespace-nowrap">Aizklāts</span>
								}
							</div>

							<h2 class="font-serif text-[20px] sm:text-[22px] font-semibold leading-[1.26] tracking-[-0.01em] text-neutral-950">
								<a
									href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", v.ID))) }
									class="hover:underline decoration-1 underline-offset-4 decoration-neutral-400 transition"
								>
									{ VoteHeadline(v) }
								</a>
							</h2>

							if meaningfulContext != "" {
								<p class="text-sm text-neutral-600 leading-relaxed line-clamp-2">
									{ meaningfulContext }
								</p>
							}

							if len(devItems) > 0 {
								<div class="pt-0.5 text-xs text-neutral-600">
									<span class="font-medium text-neutral-800">✦ Novirzes no frakcijas ({ fmt.Sprint(len(devItems)) }): </span>
									for i, item := range devItems {
										<a
											href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/deputati/%s/", ResolveMPSlug(props.Store, item.mp.MpID)))) }
											class="text-neutral-900 underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 transition"
										>
											{ item.mp.Name }
										</a>
										<span class="text-neutral-600"> ({ item.fShort } { strings.ToLower(DecisionLabel(item.mp.Decision)) })</span>
										if i < len(devItems)-1 {
											<span class="text-neutral-400" aria-hidden="true"> · </span>
										}
									}
								</div>
							}

							<!-- Mobile slim proportional bar -->
							<div class="md:hidden pt-1">
								<div class="w-full h-1 bg-neutral-100 overflow-hidden flex">
									if parPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", parPct) } class="bg-emerald-700 h-full"></div>
									}
									if pretPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", pretPct) } class="bg-rose-700 h-full"></div>
									}
									if attPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", attPct) } class="bg-amber-600 h-full"></div>
									}
									if nebPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", nebPct) } class="bg-neutral-300 h-full"></div>
									}
								</div>
							</div>
						</div>

						<!-- Right Column (Desktop): Clean Visual Anchor (Outcome + Tally + Slim Bar) -->
						<div class="hidden md:flex flex-col justify-start gap-2.5 pt-1 pl-4 border-l border-neutral-100">
							<div class="space-y-2">
								<div class="flex items-baseline justify-between gap-2">
									<span class={ "text-[11px] font-bold uppercase tracking-wider " + ResultTextClass(v.Result) }>
										{ ResultLabel(v.Result) }
									</span>
									if v.Counts.Par > 0 || v.Counts.Pret > 0 {
										<span class="text-sm font-semibold text-neutral-950 tabular-nums">
											{ fmt.Sprint(v.Counts.Par) } : { fmt.Sprint(v.Counts.Pret) }
										</span>
									}
								</div>

								<div class="w-full h-1.5 bg-neutral-100 overflow-hidden flex">
									if parPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", parPct) } class="bg-emerald-700 h-full" title={ fmt.Sprintf("Par: %d", v.Counts.Par) }></div>
									}
									if pretPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", pretPct) } class="bg-rose-700 h-full" title={ fmt.Sprintf("Pret: %d", v.Counts.Pret) }></div>
									}
									if attPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", attPct) } class="bg-amber-600 h-full" title={ fmt.Sprintf("Atturas: %d", v.Counts.Atturas) }></div>
									}
									if nebPct > 0 {
										<div style={ fmt.Sprintf("width: %.1f%%", nebPct) } class="bg-neutral-300 h-full" title={ fmt.Sprintf("Nebalsoja: %d", v.Counts.Nebalso) }></div>
									}
								</div>

								<div class="text-[11px] text-neutral-600 tabular-nums">
									{ fmt.Sprint(v.Counts.Par) } par · { fmt.Sprint(v.Counts.Pret) } pret
									if v.Counts.Atturas > 0 {
										<span> · { fmt.Sprint(v.Counts.Atturas) } att.</span>
									}
								</div>
							</div>

							<a
								href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/balsojumi/%s/", v.ID))) }
								class="text-xs font-medium text-neutral-600 hover:text-neutral-950 transition pt-1"
							>
								Skatīt balsojumu →
							</a>
						</div>
					</article>
				}
			</section>

			<!-- Progressive Load More Button (used for active search results in filter.js) -->
			<div id="filter-load-more-wrap" class="hidden pt-6 text-center">
				<button
					type="button"
					id="filter-load-more"
					class="inline-flex items-center gap-2 border border-neutral-300 bg-white hover:border-neutral-950 px-6 py-2.5 text-xs font-semibold text-neutral-900 transition cursor-pointer"
				>
					<span id="filter-load-more-text">Rādīt vairāk balsojumu</span>
				</button>
			</div>

			<!-- Static Archive Pagination -->
			if props.TotalPages > 1 {
				<nav id="static-pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 pt-6 mt-4 text-xs" aria-label="Arhīva lapas">
					<div class="text-neutral-600 tabular-nums">
						Lapa <strong class="text-neutral-950">{ fmt.Sprint(props.CurrentPage) }</strong> no <strong class="text-neutral-950">{ fmt.Sprint(props.TotalPages) }</strong> · Kopā { FormatVotesCount(props.TotalVotes) }
					</div>
					<div class="flex flex-wrap items-center gap-1">
						if props.CurrentPage > 1 {
							<a
								href={ templ.SafeURL(OverviewPageURL(props.LayoutProps.BasePath, props.CurrentPage-1)) }
								class="inline-flex items-center border border-neutral-300 bg-white hover:border-neutral-950 px-3 py-1.5 font-medium text-neutral-800 transition"
							>
								← Jaunāki
							</a>
						}
						for _, p := range PaginationWindow(props.CurrentPage, props.TotalPages) {
							if p == 0 {
								<span class="px-1.5 text-neutral-500" aria-hidden="true">…</span>
							} else if p == props.CurrentPage {
								<span aria-current="page" class="inline-flex items-center bg-neutral-950 px-2.5 py-1.5 font-semibold text-white tabular-nums">
									{ fmt.Sprint(p) }
								</span>
							} else {
								<a
									href={ templ.SafeURL(OverviewPageURL(props.LayoutProps.BasePath, p)) }
									class="inline-flex items-center border border-neutral-200 bg-white hover:border-neutral-950 px-2.5 py-1.5 text-neutral-700 tabular-nums transition"
								>
									{ fmt.Sprint(p) }
								</a>
							}
						}
						if props.CurrentPage < props.TotalPages {
							<a
								href={ templ.SafeURL(OverviewPageURL(props.LayoutProps.BasePath, props.CurrentPage+1)) }
								class="inline-flex items-center border border-neutral-300 bg-white hover:border-neutral-950 px-3 py-1.5 font-medium text-neutral-800 transition"
							>
								Vecāki →
							</a>
						}
					</div>
				</nav>
			}

			<!-- Empty State -->
			<div id="filter-empty-state" class="hidden border-y border-neutral-200 py-14 text-center text-neutral-600">
				<p class="font-serif text-lg font-semibold text-neutral-950">Nav atrasts neviens balsojums</p>
				<p class="text-xs text-neutral-600 mt-1.5">
					Pamēģiniet mainīt meklēšanas vārdu vai noņemt kādu no filtriem.
				</p>
				<button
					type="button"
					id="filter-empty-reset"
					class="mt-4 inline-flex items-center border border-neutral-950 bg-neutral-950 px-4 py-2 text-xs font-medium text-white hover:bg-neutral-800 transition cursor-pointer"
				>
					Atiestatīt visus filtrus
				</button>
			</div>

			<!-- Filter Script -->
			<script src="/assets/js/filter.js"></script>
		</div>
	}
}
