package views

import (
	"fmt"
	"strings"
	"github.com/FisersDavis/kabalsosaeima/internal/data"
	"github.com/FisersDavis/kabalsosaeima/internal/stats"
)

templ Overview(props OverviewProps) {
	@Layout(props.LayoutProps) {
		<div class="space-y-4">
			<!-- Filter Toolbar -->
			<section class="sticky top-[57px] z-30 rounded-xl bg-white/95 p-3 shadow-2xs backdrop-blur-md border border-slate-200 space-y-2.5">
				<!-- Search Row & Filtri Toggle Button -->
				<div class="flex items-center gap-2">
					<div class="relative flex-1">
						<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<input
							type="text"
							id="filter-search"
							placeholder="Meklēt likumu vai atslēgvārdu..."
							class="w-full rounded-lg border border-slate-200 bg-white py-1.5 pl-9 pr-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-400 shadow-2xs"
						/>
					</div>

					<button
						type="button"
						id="filter-toggle-btn"
						aria-expanded="false"
						aria-controls="filter-panel"
						class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700 shadow-2xs transition cursor-pointer shrink-0"
					>
						<svg class="h-3.5 w-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
						</svg>
						<span>Filtri</span>
						<span id="filter-badge" class="hidden rounded-full bg-slate-900 px-1.5 py-0.2 text-[10px] font-bold text-white">0</span>
					</button>

					<button
						type="button"
						id="filter-reset"
						class="hidden inline-flex items-center rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition cursor-pointer whitespace-nowrap shrink-0"
					>
						Notīrīt
					</button>
				</div>

				<!-- Collapsible Filter Drawer containing Gala lēmumi, Stage, Category, Outcome -->
				<div id="filter-panel" class="hidden pt-2 border-t border-slate-100 flex flex-wrap items-center gap-2">
					<!-- Tier 1 Segmented Switch -->
					<div class="inline-flex rounded-lg bg-slate-100 p-0.5 border border-slate-200 text-xs font-medium shadow-2xs shrink-0">
						<button
							type="button"
							id="filter-tier1"
							data-active="false"
							class="rounded-md px-2.5 py-1 transition cursor-pointer font-medium bg-white text-slate-700 shadow-2xs hover:text-slate-900"
						>
							Gala lēmumi (3. lasījums)
						</button>
					</div>

					<!-- Stage / Vote Type -->
					<select
						id="filter-stage"
						class="rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
					>
						<option value="ALL">Visi balsojumi</option>
						<option value="likums">Likumu pieņemšana</option>
						<option value="priekslikums">Priekšlikumi un grozījumi</option>
						<option value="procedura">Procedūra un darba kārtība</option>
					</select>

					<!-- Category / Topic -->
					<select
						id="filter-category"
						class="rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
					>
						<option value="ALL">Visi temati</option>
						for _, cat := range props.Categories {
							<option value={ cat.ID }>{ cat.Label }</option>
						}
					</select>

					<!-- Outcome -->
					<select
						id="filter-outcome"
						class="rounded-lg border border-slate-200 bg-white py-1 px-2.5 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
					>
						<option value="ALL">Visi rezultāti</option>
						<option value="PIENEMTS">Pieņemtie</option>
						<option value="NORAIDITS">Noraidītie</option>
					</select>
				</div>

				<div class="flex items-center justify-between text-[11px] text-slate-400 pt-0.5">
					<span id="filter-count" class="font-mono">
						Atrasti { fmt.Sprint(len(props.Votes)) } balsojumi
					</span>
				</div>
			</section>

			<!-- Vote Cards Feed -->
			<section class="space-y-3.5">
				for _, v := range props.Votes {
					<article
						class="vote-card rounded-xl border border-slate-200 bg-white p-4 shadow-2xs transition hover:border-slate-300 hover:shadow-xs space-y-2.5"
						data-title={ strings.ToLower(fmt.Sprintf("%s %s %s %s", v.SimplifiedTitle, v.OfficialTitle, v.BillNumber, v.Summary)) }
						data-category={ v.Category.ID }
						data-stage={ v.VoteType }
						data-outcome={ v.Result }
						data-tier1={ fmt.Sprintf("%t", v.IsTier1) }
					>
						<!-- Title + Outcome Badge -->
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-base sm:text-lg font-bold leading-snug text-slate-900">
								<a href={ templ.SafeURL(fmt.Sprintf("/balsojumi/%s/", v.ID)) } class="hover:text-emerald-700 transition">
									{ CleanVoteTitle(v.SimplifiedTitle) }
								</a>
								<span class={ "inline-flex items-center align-middle rounded-md border px-2 py-0.5 text-xs font-semibold shadow-2xs whitespace-nowrap ml-2 -translate-y-px " + ResultBadgeClass(v.Result) }>
									{ ResultLabel(v.Result) }
								</span>
							</h3>
						</div>

						<!-- Vote Tally Split -->
						<div class="flex items-center text-xs font-mono">
							<div class="flex items-center gap-2 sm:gap-2.5 text-slate-600">
								<span>
									<strong class="tabular-nums font-bold text-emerald-700">{ fmt.Sprint(v.Counts.Par) }</strong>
									<span class="font-sans text-[11px] text-slate-500">Par</span>
								</span>
								<span class="text-slate-300">·</span>
								<span>
									<strong class="tabular-nums font-bold text-rose-700">{ fmt.Sprint(v.Counts.Pret) }</strong>
									<span class="font-sans text-[11px] text-slate-500">Pret</span>
								</span>
								<span class="text-slate-300">·</span>
								<span>
									<strong class="tabular-nums font-bold text-amber-700">{ fmt.Sprint(v.Counts.Atturas) }</strong>
									<span class="font-sans text-[11px] text-slate-500">Atturas</span>
								</span>
								<span class="text-slate-300">·</span>
								<span>
									<strong class="tabular-nums font-bold text-slate-400">{ fmt.Sprint(v.Counts.Nebalso) }</strong>
									<span class="font-sans text-[11px] text-slate-400">Nebalsoja</span>
								</span>
							</div>
						</div>

						<!-- Metadata Row -->
						<div class="flex flex-wrap items-center gap-1.5 text-[11px] text-slate-400 font-normal">
							<span class="text-slate-600 font-medium">{ v.Category.Label }</span>
							<span>·</span>
							<span class="font-mono text-slate-500">{ v.SittingDate }</span>

							if v.ReadingStage != "" && v.ReadingStage != "Darba kārtība" && v.ReadingStage != "Procedūra" {
								<span>·</span>
								<span class="text-slate-500">{ v.ReadingStage }</span>
							}

							if v.BillNumber != "" {
								<span>·</span>
								<a
									href={ templ.SafeURL(fmt.Sprintf("/likumprojekti/%s/", stats.CleanBillSlug(v.BillNumber))) }
									class="font-mono text-slate-600 hover:text-emerald-700 hover:underline"
									title="Skatīt likumprojekta gaitu"
								>
									Nr. { CleanBillNr(v.BillNumber) }
								</a>
							}

							if v.IsUrgent {
								<span>·</span>
								<span class="font-semibold text-amber-700">Steidzams</span>
							}

							if v.IsSecret {
								<span>·</span>
								<span class="text-slate-500">Aizklāts balsojums</span>
							}
						</div>

						<!-- Meaningful Civic Purpose (if substantive context exists) -->
						{{ meaningfulContext := MeaningfulVotePurpose(v.Purpose) }}
						if meaningfulContext != "" {
							<p class="text-xs text-slate-600 leading-relaxed bg-slate-50/80 rounded-lg p-2.5 border border-slate-100 line-clamp-3">
								<span class="font-semibold text-slate-800">{ PurposeLabel(v.VoteType, v.ReadingStage, v.SimplifiedTitle) }: </span>
								{ meaningfulContext }
							</p>
						}

						<!-- Faction Breakdown Grouped by Stance (Option 3) -->
						{{ stanceGroups := GroupFactionDecisions(v.FactionBreakdown) }}
						if len(stanceGroups) > 0 && !v.IsSecret {
							<div class="pt-2 border-t border-slate-100 space-y-1.5 text-xs">
								for _, sg := range stanceGroups {
									<div class="flex flex-wrap items-center gap-2">
										<span class={ "inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold border tracking-wider min-w-[54px] justify-center " + DecisionBadgeClass(sg.Decision) }>
											{ sg.Decision }
										</span>
										<div class="flex flex-wrap items-center gap-1.5 text-xs">
											for i, f := range sg.Factions {
												<span class="text-slate-800 font-medium">
													{ f.ShortName }
													<span class="text-slate-500 font-mono text-[11px]">({ fmt.Sprint(f.Count) })</span>
												</span>
												if i < len(sg.Factions)-1 {
													<span class="text-slate-300">·</span>
												}
											}
										</div>
									</div>
								}
							</div>
						}

						<!-- Deviations Note (if any) -->
						{{
							type devItem struct {
								mp   data.DeviatingMP
								fShort string
							}
							var devItems []devItem
							for _, fb := range v.FactionBreakdown {
								for _, d := range fb.DeviatingMps {
									devItems = append(devItems, devItem{mp: d, fShort: fb.ShortName})
								}
							}
						}}
						if len(devItems) > 0 {
							<div class="pt-1.5 border-t border-slate-100 text-[11px] text-slate-600">
								<span class="font-semibold text-slate-800">✦ Novirzes no frakcijas ({ fmt.Sprint(len(devItems)) }): </span>
								for i, item := range devItems {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/deputati/%s/", ResolveMPSlug(props.Store, item.mp.MpID))) }
										class="font-medium text-slate-800 hover:text-emerald-700 hover:underline transition"
									>
										{ item.mp.Name }
									</a>
									<span class="text-slate-500"> ({ item.fShort } { strings.ToLower(DecisionLabel(item.mp.Decision)) })</span>
									if i < len(devItems)-1 {
										<span class="text-slate-300"> · </span>
									}
								}
							</div>
						}

						<!-- Bill Progression Timeline Accordion (Option C) -->
						{{
							var billTimeline *stats.BillTimeline
							if v.BillNumber != "" && props.BillTimelines != nil {
								billTimeline = props.BillTimelines[strings.TrimSpace(v.BillNumber)]
							}
						}}
						if billTimeline != nil {
							if billTimeline.TotalVotes > 1 {
								<div class="pt-1 border-t border-slate-100">
									<details class="group/timeline rounded-lg border border-slate-200 bg-slate-50/70 overflow-hidden transition">
										<summary class="flex items-center justify-between px-3 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100/70 cursor-pointer list-none select-none transition">
											<span class="flex items-center gap-1.5">
												<svg class="h-3.5 w-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
												<span>Likumprojekta Nr. { CleanBillNr(v.BillNumber) } gaita ({ fmt.Sprint(billTimeline.TotalVotes) } balsojumi)</span>
											</span>
											<svg class="h-3.5 w-3.5 text-slate-400 group-open/timeline:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg>
										</summary>

										<div class="px-3 pb-3 pt-1 border-t border-slate-200 bg-white space-y-2 text-xs">
											<div class="flex items-center justify-between text-[11px] text-slate-500 pb-1 border-b border-slate-100">
												<span class="font-medium text-slate-700">Hronoloģiskā secība pa lasījumiem un posmiem:</span>
												<a
													href={ templ.SafeURL(fmt.Sprintf("/likumprojekti/%s/", billTimeline.Slug)) }
													class="font-semibold text-emerald-700 hover:text-emerald-900 hover:underline"
												>
													Atvērt pilno likumprojekta lapu →
												</a>
											</div>

											<div class="space-y-1.5">
												for _, stage := range billTimeline.Stages {
													for _, sv := range stage.Votes {
														{{
															isCurrent := sv.ID == v.ID
															borderCls := "border-slate-100 bg-slate-50/50 hover:bg-slate-50"
															dotCls := "bg-slate-300"
															if isCurrent {
																borderCls = "border-emerald-300 bg-emerald-50/70 font-semibold"
																dotCls = "bg-emerald-600"
															}
														}}
														<div class={ "flex items-center justify-between p-2 rounded-lg border text-xs transition " + borderCls }>
															<div class="flex items-center gap-2 min-w-0 pr-2">
																<span class={ "h-2 w-2 rounded-full shrink-0 " + dotCls }></span>
																<span class="font-medium text-slate-900 shrink-0">{ stage.StageName }</span>
																<span class="text-slate-400 font-mono text-[11px] shrink-0">· { sv.SittingDate }</span>
																<a
																	href={ templ.SafeURL(fmt.Sprintf("/balsojumi/%s/", sv.ID)) }
																	class="text-slate-600 hover:text-emerald-700 hover:underline truncate"
																	title={ sv.OfficialTitle }
																>
																	{ CleanVoteTitle(sv.SimplifiedTitle) }
																</a>
															</div>
															<div class="flex items-center gap-2 shrink-0 text-right">
																<span class={ "inline-flex items-center rounded px-1.5 py-0.2 text-[10px] font-semibold border " + ResultBadgeClass(sv.Result) }>
																	{ ResultLabel(sv.Result) }
																</span>
																<span class="font-mono text-[11px] text-slate-500">
																	{ fmt.Sprint(sv.Counts.Par) }-{ fmt.Sprint(sv.Counts.Pret) }
																</span>
															</div>
														</div>
													}
												}
											</div>
										</div>
									</details>
								</div>
							} else {
								<div class="pt-1 border-t border-slate-100">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/likumprojekti/%s/", billTimeline.Slug)) }
										class="flex items-center justify-between px-3 py-2 rounded-lg border border-slate-200 bg-slate-50/70 hover:bg-slate-100/70 text-xs font-medium text-slate-700 hover:text-slate-900 transition"
									>
										<span class="flex items-center gap-1.5">
											<svg class="h-3.5 w-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
											<span>Likumprojekta Nr. { CleanBillNr(v.BillNumber) } gaita</span>
										</span>
										<span class="text-emerald-700 text-[11px] font-semibold hover:underline">Skatīt laika līniju →</span>
									</a>
								</div>
							}
						}

						<!-- Action Footer -->
						<div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs">
							<a
								href={ templ.SafeURL(fmt.Sprintf("/balsojumi/%s/", v.ID)) }
								class="inline-flex items-center gap-1.5 font-semibold text-emerald-800 hover:text-emerald-950 transition"
							>
								<span>Skatīt sēžu zāli un deputātus →</span>
							</a>
							<div class="flex items-center gap-1.5 sm:gap-2">
								<a
									href={ templ.SafeURL(VoteProtocolURL(v)) }
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 hover:text-emerald-800 transition underline underline-offset-2"
									title="Oficiālais Saeimas balsošanas protokols vai likumprojekta reģistrs"
								>
									<span>📄 Protokols</span>
									<svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
								</a>
								if v.StenogramURL != "" {
									<span class="text-slate-300">·</span>
									<a
										href={ templ.SafeURL(v.StenogramURL) }
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 hover:text-blue-800 transition underline underline-offset-2"
										title="Saeimas sēdes stenogramma un debates"
									>
										<span>🎙️ Stenogramma</span>
										<svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
									</a>
								}
							</div>
						</div>
					</article>
				}
			</section>

			<!-- Empty State -->
			<div id="filter-empty-state" class="hidden rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-500">
				<p class="text-sm font-semibold">Nav atrasts neviens balsojums</p>
				<p class="text-xs text-slate-400 mt-1">
					Pamēģiniet mainīt meklēšanas vārdu vai noņemt kādu no filtriem.
				</p>
				<button
					type="button"
					id="filter-empty-reset"
					class="mt-3.5 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 transition cursor-pointer"
				>
					Atiestatīt visus filtrus
				</button>
			</div>

			<!-- Filter Script -->
			<script src="/assets/js/filter.js"></script>
		</div>
	}
}
