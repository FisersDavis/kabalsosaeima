package views

import (
	"fmt"
	"strings"
)

templ MPDirectory(props MPDirectoryProps) {
	@Layout(props.LayoutProps) {
		<div class="space-y-6">
			<!-- Header & Description -->
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-slate-900">
						14. Saeimas deputāti un frakcijas
					</h1>
					<p class="mt-1 text-sm text-slate-600">
						Pārskats par visiem deputātiem, viņu frakciju piederību, sēžu apmeklētību un frakcijas disciplīnu.
					</p>
				</div>
				<div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs shrink-0">
					<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
					<span>100 aktīvi mandāti</span>
				</div>
			</div>

			<!-- Search & Filter Controls -->
			<section class="sticky top-[57px] z-30 rounded-xl bg-white/95 p-3 shadow-2xs backdrop-blur-md border border-slate-200 space-y-2.5">
				<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
					<!-- Faction Filter Dropdown -->
					<div class="flex items-center gap-2">
						<select
							id="mp-filter-faction"
							class="rounded-lg border border-slate-200 bg-white py-1.5 px-3 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
						>
							<option value="ALL">Visas frakcijas</option>
							for _, f := range props.Factions {
								<option value={ f.ID }>{ f.Name } ({ f.ShortName })</option>
							}
							<option value="pie-frakcijam-nepiederosie-deputati">Pie frakcijām nepiederošie deputāti</option>
						</select>

						<!-- Active Mandates Only Switch -->
						<button
							type="button"
							id="mp-filter-active"
							data-active="true"
							class="rounded-lg border border-slate-900 bg-slate-900 px-3 py-1.5 text-xs font-medium text-white shadow-2xs transition cursor-pointer"
						>
							Tikai aktīvie (100)
						</button>
					</div>

					<!-- Search Input + Reset -->
					<div class="flex items-center gap-2 flex-1 max-w-full sm:max-w-md">
						<div class="relative flex-1">
							<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
							<input
								type="text"
								id="mp-filter-search"
								placeholder="Meklēt deputātu pēc vārda vai uzvārda..."
								class="w-full rounded-lg border border-slate-200 bg-white py-1.5 pl-9 pr-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-400"
							/>
						</div>
						<button
							type="button"
							id="mp-filter-reset"
							class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition cursor-pointer whitespace-nowrap"
						>
							Notīrīt
						</button>
					</div>
				</div>

				<div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
					<span id="mp-filter-count">Rāda visus deputātus</span>
					<span class="text-slate-400">Sakārtots alfabētiski pēc vārda</span>
				</div>
			</section>

			<!-- Deputies Grid -->
			<div id="mp-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
				for _, item := range props.Items {
					{{
						mp := item.MP
						mandate := item.Mandate
						faction := item.Faction
						slug := mp.Slug
						if slug == "" {
							slug = mp.ID
						}

						// Avatar Initials
						initials := ""
						parts := strings.Fields(mp.Name)
						if len(parts) >= 2 {
							initials = string([]rune(parts[0])[0:1]) + string([]rune(parts[len(parts)-1])[0:1])
						} else if len(mp.Name) > 0 {
							initials = string([]rune(mp.Name)[0:1])
						}
						initials = strings.ToUpper(initials)

						color := "#64748B"
						fShort := mp.FactionID
						textColor := FactionTextColor(mp.FactionID, "")
						if faction != nil {
							if faction.Color != "" {
								color = faction.Color
							}
							if faction.ShortName != "" {
								fShort = faction.ShortName
							}
							textColor = FactionTextColor(mp.FactionID, faction.TextColor)
						}

						activeStr := "false"
						if mp.IsActive {
							activeStr = "true"
						}
					}}

					<a
						href={ templ.SafeURL(fmt.Sprintf("/deputati/%s/", slug)) }
						class="mp-card rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs flex flex-col justify-between hover:border-slate-300 hover:shadow-md transition-all group text-left cursor-pointer"
						data-name={ mp.Name }
						data-faction={ mp.FactionID }
						data-active={ activeStr }
					>
						<div>
							<div class="flex items-start gap-3">
								<!-- Initials Avatar -->
								<div
									class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs shrink-0 shadow-2xs"
									style={ fmt.Sprintf("background-color: %s; color: %s;", color, textColor) }
								>
									{ initials }
								</div>

								<div class="min-w-0 flex-1">
									<div
										class="text-xs font-bold text-slate-900 group-hover:text-slate-700 transition line-clamp-2 min-h-[34px] leading-snug"
										title={ mp.Name }
									>
										{ mp.Name }
									</div>

									<div class="mt-1 flex items-center gap-1.5 flex-wrap">
										<span
											class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold shadow-2xs"
											style={ fmt.Sprintf("background-color: %s; color: %s;", color, textColor) }
										>
											{ fShort }
										</span>

										if mp.SeatNumber > 0 {
											<span class="text-[10px] text-slate-400 font-mono">
												Nr. { fmt.Sprintf("%d", mp.SeatNumber) }
											</span>
										}

										if !mp.IsActive {
											<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-medium">
												Mandāts neaktīvs
											</span>
										}
									</div>
								</div>
							</div>

							<!-- Metrics Lockup -->
							<div class="mt-3 pt-2.5 border-t border-slate-100 grid grid-cols-2 gap-2 text-center">
								<!-- Attendance -->
								<div class="rounded-lg bg-slate-50/80 p-2 border border-slate-100">
									if item.Attendance.TotalEligibleVotes > 0 {
										{{
											attColor := "text-slate-800"
											if item.Attendance.PresentPct >= 85 {
												attColor = "text-emerald-700"
											} else if item.Attendance.PresentPct < 70 {
												attColor = "text-rose-600"
											}
										}}
										<div class={ fmt.Sprintf("font-mono text-sm font-bold %s", attColor) }>
											{ fmt.Sprintf("%.1f%%", item.Attendance.PresentPct) }
										</div>
									} else {
										<div class="font-mono text-sm font-bold text-slate-400">
											—
										</div>
									}
									<div class="text-[9px] uppercase font-semibold tracking-wider text-slate-400 mt-0.5">
										Klātbūtne
									</div>
								</div>

								<!-- Cohesion -->
								<div class="rounded-lg bg-slate-50/80 p-2 border border-slate-100">
									if !item.Cohesion.IsIndependent && item.Cohesion.CohesionPct != nil {
										<div class="font-mono text-sm font-bold text-slate-800">
											{ fmt.Sprintf("%.1f%%", *item.Cohesion.CohesionPct) }
										</div>
										<div class="text-[9px] uppercase font-semibold tracking-wider text-slate-400 mt-0.5">
											Vienotība
										</div>
									} else {
										<div class="font-mono text-sm font-bold text-slate-400">
											—
										</div>
										<div class="text-[9px] uppercase font-semibold tracking-wider text-slate-400 mt-0.5" title="Neatkarīgais deputāts">
											Neatkarīgais
										</div>
									}
								</div>
							</div>

							if mandate != nil && mandate.Note != "" && !mp.IsActive {
								<div class="mt-2 text-[10px] text-slate-500 italic line-clamp-1" title={ mandate.Note }>
									{ mandate.Note }
								</div>
							}
						</div>
					</a>
				}
			</div>

			<!-- Empty State -->
			<div id="mp-empty-state" class="hidden rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-500">
				<p class="text-sm font-semibold">Nav atrasts neviens deputāts</p>
				<p class="text-xs text-slate-400 mt-1">
					Pamēģiniet mainīt meklēšanas vārdu vai atiestatīt frakcijas filtru.
				</p>
			</div>

			<!-- Mandate Handover Note -->
			<div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3.5 flex items-start gap-3 text-xs text-slate-600">
				<svg class="h-4 w-4 text-slate-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
				<div class="leading-relaxed">
					<strong class="text-slate-800">Par mandātu aizvietošanu:</strong> Saskaņā ar Saeimas kārtības rulli, deputātam kļūstot par Ministru prezidentu vai ministru, viņa Saeimas mandāts tiek apturēts, un tā vietā nāk nākamais attiecīgā vēlēšanu saraksta kandidāts («mīkstais mandāts»). Šeit uzrādīti gan 100 šobrīd aktīvie deputāti, gan mandātu nolikušie locekļi.
				</div>
			</div>

			<!-- MP Directory Filter Script -->
			<script src="/assets/js/mp-filter.js"></script>
		</div>
	}
}
