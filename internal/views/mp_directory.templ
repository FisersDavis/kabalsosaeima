package views

import (
	"fmt"
	"strings"
)

templ MPDirectory(props MPDirectoryProps) {
	@Layout(props.LayoutProps) {
		<div class="space-y-6">
			<!-- Header & Description -->
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-slate-900">
						14. Saeimas deputāti un frakcijas
					</h1>
					<p class="mt-1 text-sm text-slate-600">
						Pārskats par visiem deputātiem, viņu frakciju piederību, sēžu apmeklētību un balsojumu sakritību ar partiju.
					</p>
				</div>
				<div class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs shrink-0">
					<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
					<span>100 aktīvi mandāti</span>
				</div>
			</div>

			<!-- Deputies Table with Integrated Toolbar Matching Balsojumi Page -->
			<div class="rounded-xl border border-slate-200 bg-white shadow-2xs overflow-hidden">
				<!-- Table Toolbar Matching Balsojumi Page -->
				<div class="px-4 py-3 bg-slate-50/90 border-b border-slate-200 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 text-xs">
					<div class="font-bold text-slate-800 flex items-center gap-2 shrink-0">
						<span>Deputātu saraksts</span>
						<span id="mp-filter-count" class="px-2 py-0.5 rounded-full bg-slate-200/80 font-mono text-[10px] text-slate-700 font-semibold">
							100 aktīvi deputāti
						</span>
					</div>

					<!-- Faction filter, Active toggle, Search input & Reset -->
					<div class="flex flex-wrap items-center gap-2 flex-1 justify-end">
						<select
							id="mp-filter-faction"
							class="rounded-lg border border-slate-200 bg-white py-1.5 px-3 text-xs text-slate-700 font-medium focus:border-slate-400 focus:outline-none cursor-pointer hover:border-slate-300 shadow-2xs"
						>
							<option value="ALL">Visas frakcijas</option>
							for _, f := range props.Factions {
								<option value={ f.ID }>{ f.Name } ({ f.ShortName })</option>
							}
							<option value="pie-frakcijam-nepiederosie-deputati">Pie frakcijām nepiederošie</option>
						</select>

						<button
							type="button"
							id="mp-filter-active"
							data-active="true"
							class="rounded-lg border border-slate-900 bg-slate-900 px-3 py-1.5 text-xs font-medium text-white shadow-2xs transition cursor-pointer shrink-0"
						>
							Tikai aktīvie (100)
						</button>

						<div class="relative flex-1 min-w-[180px] max-w-full sm:max-w-xs">
							<svg class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
							<input
								type="text"
								id="mp-filter-search"
								placeholder="Meklēt deputātu pēc vārda..."
								class="w-full rounded-lg border border-slate-200 bg-white py-1.5 pl-9 pr-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-400 shadow-2xs"
							/>
						</div>

						<button
							type="button"
							id="mp-filter-reset"
							class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-100 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition cursor-pointer whitespace-nowrap shrink-0"
							title="Atiestatīt meklēšanu un filtrus"
						>
							Notīrīt
						</button>
					</div>
				</div>

				<div class="overflow-x-auto max-h-[640px] overflow-y-auto">
					<table class="w-full text-left text-xs border-collapse table-fixed">
						<colgroup>
							<col class="w-[36%] sm:w-[34%]"/>
							<col class="w-[30%] sm:w-[34%]"/>
							<col class="w-[17%] sm:w-[16%]"/>
							<col class="w-[17%] sm:w-[16%]"/>
						</colgroup>
						<thead class="sticky top-0 z-10 bg-slate-50/95 border-b border-slate-200 text-[11px] font-semibold text-slate-600 backdrop-blur-xs">
							<tr>
								<th scope="col" class="py-3 px-3.5 sm:px-4 cursor-pointer hover:text-slate-900 group select-none transition" data-sort="name" title="Kārtot pēc vārda">
									<div class="flex items-center gap-1.5">
										<span>Deputāts</span>
										<span class="sort-icon text-slate-400 group-hover:text-slate-700 font-mono text-[10px]">↕</span>
									</div>
								</th>
								<th scope="col" class="py-3 px-3.5 sm:px-4 cursor-pointer hover:text-slate-900 group select-none transition" data-sort="faction" title="Kārtot pēc frakcijas">
									<div class="flex items-center gap-1.5">
										<span>Frakcija</span>
										<span class="sort-icon text-slate-400 group-hover:text-slate-700 font-mono text-[10px]">↕</span>
									</div>
								</th>
								<th scope="col" class="py-3 px-3.5 sm:px-4 text-right cursor-pointer hover:text-slate-900 group select-none transition" data-sort="attendance" title="Kārtot pēc klātbūtnes">
									<div class="flex items-center justify-end gap-1.5">
										<span>Klātbūtne</span>
										<span class="sort-icon text-slate-400 group-hover:text-slate-700 font-mono text-[10px]">↕</span>
									</div>
								</th>
								<th scope="col" class="py-3 px-3.5 sm:px-4 text-right cursor-pointer hover:text-slate-900 group select-none transition" data-sort="cohesion" title="Kārtot pēc balsojumu sakritības">
									<div class="flex items-center justify-end gap-1.5">
										<span>Balsojumu sakritība ar partiju</span>
										<span class="sort-icon text-slate-400 group-hover:text-slate-700 font-mono text-[10px]">↕</span>
									</div>
								</th>
							</tr>
						</thead>
						<tbody id="mp-tbody" class="divide-y divide-slate-100">
							for _, item := range props.Items {
								{{
									mp := item.MP
									mandate := item.Mandate
									faction := item.Faction
									slug := mp.Slug
									if slug == "" {
										slug = mp.ID
									}

									// Avatar Initials
									initials := ""
									parts := strings.Fields(mp.Name)
									if len(parts) >= 2 {
										initials = string([]rune(parts[0])[0:1]) + string([]rune(parts[len(parts)-1])[0:1])
									} else if len(mp.Name) > 0 {
										initials = string([]rune(mp.Name)[0:1])
									}
									initials = strings.ToUpper(initials)

									color := "#64748B"
									fShort := mp.FactionID
									fName := "Pie frakcijām nepiederošs"
									textColor := FactionTextColor(mp.FactionID, "")
									if faction != nil {
										if faction.Color != "" {
											color = faction.Color
										}
										if faction.ShortName != "" {
											fShort = faction.ShortName
										}
										if faction.Name != "" {
											fName = faction.Name
										}
										textColor = FactionTextColor(mp.FactionID, faction.TextColor)
									}

									activeStr := "false"
									if mp.IsActive {
										activeStr = "true"
									}

									cohesionVal := -1.0
									if !item.Cohesion.IsIndependent && item.Cohesion.CohesionPct != nil {
										cohesionVal = *item.Cohesion.CohesionPct
									}
								}}

								<tr
									class="mp-row hover:bg-slate-50/80 transition group"
									data-name={ mp.Name }
									data-faction={ fShort }
									data-faction-id={ mp.FactionID }
									data-active={ activeStr }
									data-attendance={ fmt.Sprintf("%.2f", item.Attendance.PresentPct) }
									data-cohesion={ fmt.Sprintf("%.2f", cohesionVal) }
								>
									<!-- Deputāts Column -->
									<td class="py-3 px-3.5 sm:px-4">
										<a href={ templ.SafeURL(fmt.Sprintf("/deputati/%s/", slug)) } class="flex items-center gap-2.5 sm:gap-3 group-hover:text-emerald-800 transition min-w-0">
											<div
												class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-[11px] shrink-0 shadow-2xs"
												style={ fmt.Sprintf("background-color: %s; color: %s;", color, textColor) }
											>
												{ initials }
											</div>
											<div class="min-w-0">
												<div class="font-bold text-slate-900 group-hover:text-emerald-700 transition flex items-center gap-1.5 flex-wrap">
													<span class="truncate">{ mp.Name }</span>
													if !mp.IsActive {
														<span class="inline-flex items-center px-1.5 py-0.2 rounded bg-slate-100 text-slate-600 text-[9px] font-medium border border-slate-200 shrink-0">
															Neaktīvs
														</span>
													}
												</div>
												if mandate != nil && mandate.Note != "" && !mp.IsActive {
													<div class="text-[10px] text-slate-400 truncate italic max-w-xs sm:max-w-md" title={ mandate.Note }>
														{ mandate.Note }
													</div>
												}
											</div>
										</a>
									</td>

									<!-- Faction Column -->
									<td class="py-3 px-3.5 sm:px-4">
										<div class="flex items-center gap-1.5 min-w-0">
											<span
												class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold shadow-2xs shrink-0"
												style={ fmt.Sprintf("background-color: %s; color: %s;", color, textColor) }
											>
												{ fShort }
											</span>
											<span class="hidden sm:inline text-xs text-slate-500 truncate" title={ fName }>
												{ fName }
											</span>
										</div>
									</td>

									<!-- Attendance Column -->
									<td class="py-3 px-3.5 sm:px-4 text-right">
										if item.Attendance.TotalEligibleVotes > 0 {
											{{
												attColor := "text-slate-800"
												if item.Attendance.PresentPct >= 85 {
													attColor = "text-emerald-700"
												} else if item.Attendance.PresentPct < 70 {
													attColor = "text-rose-600"
												}
											}}
											<div class={ fmt.Sprintf("font-mono text-xs sm:text-sm font-bold %s", attColor) }>
												{ fmt.Sprintf("%.1f%%", item.Attendance.PresentPct) }
											</div>
											<div class="text-[10px] text-slate-400 font-mono">
												{ fmt.Sprint(item.Attendance.PresentCount) }/{ fmt.Sprint(item.Attendance.TotalEligibleVotes) }
											</div>
										} else {
											<span class="font-mono text-xs text-slate-400">—</span>
										}
									</td>

									<!-- Voting Alignment Column -->
									<td class="py-3 px-3.5 sm:px-4 text-right">
										if !item.Cohesion.IsIndependent && item.Cohesion.CohesionPct != nil {
											<div class="font-mono text-xs sm:text-sm font-bold text-slate-800">
												{ fmt.Sprintf("%.1f%%", *item.Cohesion.CohesionPct) }
											</div>
										} else {
											<span class="font-mono text-xs text-slate-400" title="Pie frakcijām nepiederošs deputāts">—</span>
										}
									</td>
								</tr>
							}
							<tr id="mp-empty-row" class="hidden">
								<td colspan="4" class="py-12 text-center text-slate-400 text-xs">
									Nav atrasts neviens deputāts pēc izvēlētajiem filtriem.
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!-- Mandate Handover Note -->
			<div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3.5 flex items-start gap-3 text-xs text-slate-600">
				<svg class="h-4 w-4 text-slate-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
				<div class="leading-relaxed">
					<strong class="text-slate-800">Par mandātu aizvietošanu:</strong> Saskaņā ar Saeimas kārtības rulli, deputātam kļūstot par Ministru prezidentu vai ministru, viņa Saeimas mandāts tiek apturēts, un tā vietā nāk nākamais attiecīgā vēlēšanu saraksta kandidāts («mīkstais mandāts»). Šeit uzrādīti gan 100 šobrīd aktīvie deputāti, gan mandātu nolikušie locekļi.
				</div>
			</div>

			<!-- MP Directory Filter & Sort Script -->
			<script src="/assets/js/mp-filter.js"></script>
		</div>
	}
}
