package views

import (
	"fmt"
)

templ MPDirectory(props MPDirectoryProps) {
	{{
		isActiveTerm := IsLayoutTermActive(props.LayoutProps)
		activeCount := DirectoryActiveCount(props.Items)
	}}
	@Layout(props.LayoutProps) {
		<div class="space-y-6" id="mp-directory-root" data-term-active={ fmt.Sprintf("%t", isActiveTerm) }>
			<!-- Editorial Section Header -->
			<header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 border-b border-neutral-200">
				<div class="space-y-1.5">
					<h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-[-0.015em] text-neutral-950 leading-tight">
						{ fmt.Sprintf("%d. Saeimas deputāti un frakcijas", ActiveTermNumber(props.LayoutProps)) }
					</h1>
					<p class="text-sm text-neutral-600 max-w-2xl">
						Pārskats par deputātu frakciju piederību, sēžu klātbūtni aktīvā mandāta laikā un balsojumu sakritību ar partiju.
					</p>
				</div>
				<div class="text-xs text-neutral-600 tabular-nums shrink-0">
					if isActiveTerm {
						<span class="font-semibold text-neutral-900">{ FormatActiveMandatesCount(activeCount) }</span>
						<span class="mx-1.5 text-neutral-300" aria-hidden="true">·</span>
						<span>kopā { fmt.Sprint(len(props.Items)) } sasaukumā</span>
					} else {
						<span class="font-semibold text-neutral-900">Arhīvs</span>
						<span class="mx-1.5 text-neutral-300" aria-hidden="true">·</span>
						<span>{ FormatDeputiesCount(len(props.Items)) } sasaukumā</span>
					}
				</div>
			</header>

			<!-- Clean Single-Row Editorial Filter Toolbar -->
			<section class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
				<div class="flex flex-wrap items-center gap-2.5 flex-1">
					<div class="relative flex-1 min-w-[200px] sm:max-w-xs">
						<svg class="absolute left-0 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-500" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
						<label for="mp-filter-search" class="sr-only">Meklēt deputātu pēc vārda</label>
						<input
							type="text"
							id="mp-filter-search"
							aria-label="Meklēt deputātu pēc vārda"
							placeholder="Meklēt deputātu..."
							class="w-full border-0 border-b border-neutral-300 bg-transparent py-1.5 pl-6 pr-2 text-sm text-neutral-950 placeholder:text-neutral-500 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 transition"
						/>
					</div>

					<select
						id="mp-filter-faction"
						aria-label="Filtrēt deputātus pēc frakcijas"
						class="border border-neutral-300 bg-white py-1.5 px-2.5 text-xs text-neutral-800 focus:border-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer max-w-[240px]"
					>
						<option value="ALL">Visas frakcijas</option>
						for _, f := range props.Factions {
							<option value={ f.ID }>{ f.ShortName } — { f.Name }</option>
						}
					</select>

					<button
						type="button"
						id="mp-filter-active"
						data-active="true"
						aria-pressed="true"
						class="border border-neutral-950 bg-neutral-950 px-3 py-1.5 text-xs font-medium text-white transition cursor-pointer shrink-0 tabular-nums"
					>
						if isActiveTerm {
							Tikai aktīvie ({ fmt.Sprint(activeCount) })
						} else {
							Beigu sastāvs ({ fmt.Sprint(activeCount) })
						}
					</button>

					<button
						type="button"
						id="mp-filter-reset"
						class="hidden text-xs font-medium text-neutral-600 hover:text-neutral-950 underline underline-offset-4 transition cursor-pointer whitespace-nowrap shrink-0"
						title="Atiestatīt meklēšanu un filtrus"
					>
						Notīrīt
					</button>
				</div>

				<div class="text-xs text-neutral-600 tabular-nums shrink-0">
					<span id="mp-filter-count" aria-live="polite">
						if isActiveTerm {
							{ FormatActiveDeputiesCount(activeCount) }
						} else {
							{ fmt.Sprint(activeCount) } noslēguma sastāvā
						}
					</span>
				</div>
			</section>

			<!-- Newspaper Hairline Table -->
			<div class="overflow-x-auto border-t border-neutral-950">
				<table class="w-full text-left text-sm border-collapse table-fixed">
					<colgroup>
						<col class="w-[40%] sm:w-[35%]"/>
						<col class="w-[16%] sm:w-[28%]"/>
						<col class="w-[22%] sm:w-[15%]"/>
						<col class="w-[22%] sm:w-[22%]"/>
					</colgroup>
					<thead class="border-b border-neutral-200 bg-white text-[10px] sm:text-[11px] font-semibold uppercase tracking-normal sm:tracking-wider text-neutral-600">
						<tr>
							<th scope="col" class="py-3 px-1.5 sm:px-3" data-sort="name" aria-sort="ascending">
								<button type="button" class="inline-flex items-center gap-0.5 sm:gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap">
									<span>Deputāts</span>
									<span class="sort-icon text-neutral-950 text-[10px]" aria-hidden="true">↑</span>
								</button>
							</th>
							<th scope="col" class="py-3 px-1 sm:px-3" data-sort="faction" aria-sort="none">
								<button type="button" class="inline-flex items-center gap-0.5 sm:gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap">
									<span class="hidden sm:inline">Frakcija</span>
									<abbr title="Frakcija" class="sm:hidden no-underline">Frakc.</abbr>
									<span class="sort-icon text-neutral-500 text-[10px]" aria-hidden="true">↕</span>
								</button>
							</th>
							<th scope="col" class="py-3 px-1 sm:px-3 text-right" data-sort="attendance" aria-sort="none">
								<button type="button" class="inline-flex items-center justify-end gap-0.5 sm:gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap ml-auto">
									<span>Klātbūtne</span>
									<span class="sort-icon text-neutral-500 text-[10px]" aria-hidden="true">↕</span>
								</button>
							</th>
							<th scope="col" class="py-3 px-1.5 sm:px-3 text-right" data-sort="cohesion" aria-sort="none">
								<button type="button" class="inline-flex items-center justify-end gap-0.5 sm:gap-1 uppercase font-semibold text-neutral-600 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 cursor-pointer select-none transition whitespace-nowrap ml-auto">
									<span class="hidden md:inline">Sakritība ar partiju</span>
									<span class="md:hidden">Sakritība</span>
									<span class="sort-icon text-neutral-500 text-[10px]" aria-hidden="true">↕</span>
								</button>
							</th>
						</tr>
					</thead>
					<tbody id="mp-tbody" class="divide-y divide-neutral-100">
						for _, item := range props.Items {
							{{
								mp := item.MP
								mandate := item.Mandate
								faction := item.Faction
								slug := mp.Slug
								if slug == "" {
									slug = mp.ID
								}

								color := "#525252"
								fShort := mp.FactionID
								fName := "Pie frakcijām nepiederošs"
								if faction != nil {
									if faction.Color != "" {
										color = faction.Color
									}
									if faction.ShortName != "" {
										fShort = faction.ShortName
									}
									if faction.Name != "" {
										fName = faction.Name
									}
								}

								activeStr := "false"
								if mp.IsActive {
									activeStr = "true"
								}

								cohesionVal := -1.0
								if !item.Cohesion.IsIndependent && item.Cohesion.CohesionPct != nil {
									cohesionVal = *item.Cohesion.CohesionPct
								}
							}}

							<tr
								class="mp-row hover:bg-neutral-50 transition group"
								data-name={ mp.Name }
								data-faction={ fShort }
								data-faction-id={ mp.FactionID }
								data-active={ activeStr }
								data-attendance={ fmt.Sprintf("%.2f", item.Attendance.PresentPct) }
								data-cohesion={ fmt.Sprintf("%.2f", cohesionVal) }
							>
								<!-- Deputāts Column -->
								<td class="py-3.5 px-1.5 sm:px-3">
									<a href={ templ.SafeURL(TermURL(props.LayoutProps.BasePath, fmt.Sprintf("/deputati/%s/", slug))) } class="flex items-center gap-2 sm:gap-2.5 min-w-0">
										<span class="w-2 h-2 rounded-full shrink-0" style={ fmt.Sprintf("background-color: %s;", color) } aria-hidden="true"></span>
										<div class="min-w-0">
											<div class="font-medium text-neutral-950 group-hover:underline underline-offset-2 flex items-center gap-1.5 sm:gap-2 flex-wrap">
												<span class="truncate">{ mp.Name }</span>
												if !mp.IsActive {
													<span class="text-[10px] font-medium uppercase tracking-wider text-neutral-600 shrink-0">
														Neaktīvs
													</span>
												}
											</div>
											if mandate != nil && mandate.Note != "" && !mp.IsActive {
												<div class="text-xs text-neutral-600 truncate max-w-xs sm:max-w-md" title={ mandate.Note }>
													{ mandate.Note }
												</div>
											}
										</div>
									</a>
								</td>

								<!-- Faction Column -->
								<td class="py-3.5 px-1 sm:px-3">
									<div class="flex items-baseline gap-2 min-w-0">
										<span class="text-xs font-semibold text-neutral-900 shrink-0">
											{ fShort }
										</span>
										<span class="hidden sm:inline text-xs text-neutral-600 truncate" title={ fName }>
											{ fName }
										</span>
									</div>
								</td>

								<!-- Attendance Column -->
								<td class="py-3.5 px-1 sm:px-3 text-right tabular-nums">
									if item.Attendance.TotalEligibleVotes > 0 {
										{{
											attColor := "text-neutral-900"
											if item.Attendance.PresentPct >= 85 {
												attColor = "text-emerald-800"
											} else if item.Attendance.PresentPct < 70 {
												attColor = "text-rose-800"
											}
										}}
										<div class={ fmt.Sprintf("text-sm font-semibold %s", attColor) }>
											{ fmt.Sprintf("%.1f%%", item.Attendance.PresentPct) }
										</div>
										<div class="text-[11px] text-neutral-600">
											{ fmt.Sprint(item.Attendance.PresentCount) }/{ fmt.Sprint(item.Attendance.TotalEligibleVotes) }
										</div>
									} else {
										<span class="text-xs text-neutral-600">—</span>
									}
								</td>

								<!-- Voting Alignment Column -->
								<td class="py-3.5 px-1.5 sm:px-3 text-right tabular-nums">
									if !item.Cohesion.IsIndependent && item.Cohesion.CohesionPct != nil {
										<div class="text-sm font-semibold text-neutral-900">
											{ fmt.Sprintf("%.1f%%", *item.Cohesion.CohesionPct) }
										</div>
									} else {
										<span class="text-xs text-neutral-600" title="Pie frakcijām nepiederošs deputāts">—</span>
									}
								</td>
							</tr>
						}
						<tr id="mp-empty-row" class="hidden">
							<td colspan="4" class="py-12 text-center text-neutral-600 text-xs">
								Nav atrasts neviens deputāts pēc izvēlētajiem filtriem.
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Quiet Editorial Footnote -->
			<p class="border-t border-neutral-200 pt-4 text-xs text-neutral-600 leading-relaxed max-w-3xl">
				if isActiveTerm {
					<strong class="font-semibold text-neutral-800">Par mandātu aizvietošanu:</strong> Saskaņā ar Saeimas kārtības rulli deputātam kļūstot par Ministru prezidentu vai ministru, viņa Saeimas mandāts tiek apturēts, un tā vietā nāk nākamais attiecīgā vēlēšanu saraksta kandidāts („mīkstais mandāts“). Sarakstā pieejami gan { fmt.Sprint(activeCount) } šobrīd aktīvie deputāti, gan mandātu nolikušie locekļi.
				} else {
					<strong class="font-semibold text-neutral-800">Par sasaukuma arhīvu:</strong> { fmt.Sprintf("%d. Saeimas", ActiveTermNumber(props.LayoutProps)) } pilnvaras ir noslēgušās. Sarakstā pieejami gan { fmt.Sprint(activeCount) } noslēguma sastāva deputāti, gan visi pārējie sasaukuma gaitā strādājušie deputāti un ministri (kopā { fmt.Sprint(len(props.Items)) }).
				}
			</p>

			<!-- MP Directory Filter & Sort Script -->
			<script src="/assets/js/mp-filter.js"></script>
		</div>
	}
}
