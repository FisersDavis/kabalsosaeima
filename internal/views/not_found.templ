package views

templ NotFound(props NotFoundProps) {
	@Layout(props.LayoutProps) {
		<section class="mx-auto max-w-xl py-12 sm:py-16 text-center space-y-5">
			<div class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3.5 py-1 font-mono text-xs font-bold text-slate-500 shadow-2xs">
				HTTP 404
			</div>
			<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
				Lapa netika atrasta
			</h1>
			<p class="text-sm text-slate-600 leading-relaxed">
				Pieprasītā adrese neeksistē vai ir pārvietota uz citu Saeimas sasaukuma arhīva sadaļu.
				Izmantojiet saites zemāk, lai atgrieztos balsojumu vai deputātu sarakstā.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
				<a
					href="/"
					class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow-2xs hover:bg-slate-800 transition"
				>
					<span>15. Saeimas balsojumi</span>
				</a>
				<a
					href="/14-saeima/"
					class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 transition"
				>
					<span>14. Saeimas arhīvs</span>
				</a>
				<a
					href="/deputati/"
					class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 transition"
				>
					<span>Partijas un deputāti</span>
				</a>
			</div>
		</section>
	}
}
