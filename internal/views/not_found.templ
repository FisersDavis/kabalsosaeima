package views

import "fmt"

templ NotFound(props NotFoundProps) {
	@Layout(props.LayoutProps) {
		<section class="mx-auto max-w-xl py-16 sm:py-24 text-center space-y-5">
			<div class="text-xs font-semibold uppercase tracking-widest text-neutral-600">
				HTTP 404
			</div>
			<h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-950">
				Lapa netika atrasta
			</h1>
			<p class="text-sm text-neutral-600 leading-relaxed">
				Pieprasītā adrese neeksistē vai ir pārvietota uz citu Saeimas sasaukuma arhīva sadaļu.
				Izmantojiet saites zemāk, lai atgrieztos balsojumu vai deputātu sarakstā.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-3 pt-3">
				if len(props.LayoutProps.Terms) > 0 {
					for i, t := range props.LayoutProps.Terms {
						if i == 0 {
							<a
								href={ templ.SafeURL(TermURL(t.BasePath, "/")) }
								class="inline-flex items-center bg-neutral-950 px-5 py-2.5 text-xs font-semibold text-white hover:bg-neutral-800 transition"
							>
								{ fmt.Sprintf("%d. Saeimas balsojumi", t.Term) }
							</a>
						} else {
							<a
								href={ templ.SafeURL(TermURL(t.BasePath, "/")) }
								class="inline-flex items-center border border-neutral-300 bg-white px-5 py-2.5 text-xs font-semibold text-neutral-800 hover:border-neutral-950 transition"
							>
								{ fmt.Sprintf("%d. Saeimas arhīvs", t.Term) }
							</a>
						}
					}
				} else {
					<a
						href="/"
						class="inline-flex items-center bg-neutral-950 px-5 py-2.5 text-xs font-semibold text-white hover:bg-neutral-800 transition"
					>
						{ fmt.Sprintf("%d. Saeimas balsojumi", ActiveTermNumber(props.LayoutProps)) }
					</a>
					<a
						href="/14-saeima/"
						class="inline-flex items-center border border-neutral-300 bg-white px-5 py-2.5 text-xs font-semibold text-neutral-800 hover:border-neutral-950 transition"
					>
						14. Saeimas arhīvs
					</a>
				}
				<a
					href="/deputati/"
					class="inline-flex items-center border border-neutral-300 bg-white px-5 py-2.5 text-xs font-semibold text-neutral-800 hover:border-neutral-950 transition"
				>
					Partijas un deputāti
				</a>
			</div>
		</section>
	}
}
