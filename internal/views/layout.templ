package views

import "fmt"

templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="lv" class="h-full bg-white text-neutral-950 antialiased">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<meta name="description" content={ props.Description }/>
			if props.NoIndex {
				<meta name="robots" content="noindex"/>
			}
			<meta property="og:title" content={ props.Title }/>
			<meta property="og:description" content={ props.Description }/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content={ props.CanonicalURL }/>
			<meta property="og:locale" content="lv_LV"/>
			<meta property="og:image" content="https://kabalsosaeima.lv/og-image.png"/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content="Kā Balso Saeima — Latvijas Republikas Saeimas balsojumu arhīvs"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:image" content="https://kabalsosaeima.lv/og-image.png"/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="canonical" href={ props.CanonicalURL }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<script src="/assets/js/redirect.js"></script>
			<script src="/assets/js/debates.js" defer></script>
		</head>
		<body class="min-h-full flex flex-col font-sans bg-white text-neutral-950">
			<a
				href="#main-content"
				class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-neutral-950 focus:text-white focus:px-4 focus:py-2 focus:text-xs focus:font-semibold"
			>
				Pāriet uz saturu
			</a>

			<!-- Newspaper Masthead -->
			<header id="site-header" class="w-full bg-white">
				<!-- Top Utility Bar -->
				<div class="border-b border-neutral-200">
					<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-4 py-2 sm:px-6 lg:px-8 text-xs text-neutral-600">
						<div class="flex items-center gap-2">
							<span class="hidden sm:inline">Latvijas Republikas Saeimas balsojumu arhīvs</span>
							<span class="sm:hidden">Saeimas balsojumu arhīvs</span>
							if props.Metadata.LatestSittingDate != "" {
								<span class="text-neutral-300" aria-hidden="true">|</span>
								<span class="tabular-nums">Pēdējā sēde: { FormatLatvianDate(props.Metadata.LatestSittingDate) }</span>
							}
						</div>

						<div class="flex items-center gap-3">
							if len(props.Terms) > 1 {
								<nav class="inline-flex items-center gap-2" aria-label="Saeimas sasaukuma izvēle">
									for i, t := range props.Terms {
										{{
											isSelected := t.Term == ActiveTermNumber(props)
											targetPath := "/"
											if props.ActiveNav == "mps" {
												targetPath = "/deputati/"
											}
											href := TermURL(t.BasePath, targetPath)
										}}
										if i > 0 {
											<span class="text-neutral-300" aria-hidden="true">/</span>
										}
										if isSelected {
											<a
												href={ templ.SafeURL(href) }
												aria-current="page"
												class="font-semibold text-neutral-950 underline underline-offset-4 decoration-neutral-950"
												title={ fmt.Sprintf("%s (%s)", t.Label, t.Years) }
											>
												{ t.Label }
											</a>
										} else {
											<a
												href={ templ.SafeURL(href) }
												class="text-neutral-600 hover:text-neutral-950 transition"
												title={ fmt.Sprintf("Skatīt %d. Saeimas arhīvu (%s)", t.Term, t.Years) }
											>
												{ t.Label }
											</a>
										}
									}
								</nav>
							} else {
								<span class="font-medium text-neutral-700">
									{ fmt.Sprintf("%d. Saeima (%s)", ActiveTermNumber(props), ActiveTermYears(props)) }
								</span>
							}

							<span class="hidden sm:inline text-neutral-300" aria-hidden="true">|</span>
							<a
								href={ templ.SafeURL(SaeimaDeputiesRegistryURL(ActiveTermNumber(props))) }
								target="_blank"
								rel="noopener noreferrer"
								class="hidden sm:inline-flex items-center gap-1 text-neutral-600 hover:text-neutral-950 transition"
								title="Oficiālais Saeimas portāls"
							>
								<span>saeima.lv</span>
								<span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Masthead Wordmark -->
				<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
					<div class="flex items-baseline justify-between gap-4 py-4 sm:py-5 border-b border-neutral-950">
						<a href={ templ.SafeURL(TermURL(props.BasePath, "/")) } class="inline-flex items-center gap-2.5 group">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" class="h-6 w-6 sm:h-7 sm:w-7 text-neutral-950 shrink-0" aria-hidden="true">
								<g fill="none" stroke="currentColor" stroke-width="6.5" stroke-dasharray="21.25 5">
									<path d="M8.2 58.4a35.8 35.8 0 0 1 71.6 0" pathLength="100"></path>
									<path d="M17.8 58.4a26.2 26.2 0 0 1 52.4 0" pathLength="100"></path>
								</g>
								<path fill="currentColor" d="M32 49h24v9.4H32z"></path>
							</svg>
							<span class="font-serif text-2xl sm:text-[32px] font-bold tracking-tight text-neutral-950 leading-none">
								Kā Balso Saeima
							</span>
						</a>
						<span class="hidden md:inline text-xs text-neutral-600">
							{ fmt.Sprintf("%d. Saeima · %s", ActiveTermNumber(props), ActiveTermYears(props)) }
						</span>
					</div>

					<!-- Primary Section Navigation (NYTimes-style hairline tabs) -->
					<div class="flex items-center justify-between border-b border-neutral-200 pt-3">
						<nav class="flex items-center gap-6" aria-label="Sadaļu izvēle">
							<a
								href={ templ.SafeURL(TermURL(props.BasePath, "/")) }
								class={ NavLinkClass(props.ActiveNav == "votes") }
								if props.ActiveNav == "votes" {
									aria-current="page"
								}
							>
								<span>Balsojumi</span>
								if props.Metadata.TotalVotes > 0 {
									<span class="text-xs font-normal text-neutral-500 tabular-nums">{ fmt.Sprint(props.Metadata.TotalVotes) }</span>
								}
							</a>
							<a
								href={ templ.SafeURL(TermURL(props.BasePath, "/deputati/")) }
								class={ NavLinkClass(props.ActiveNav == "mps") }
								if props.ActiveNav == "mps" {
									aria-current="page"
								}
							>
								<span>Partijas un deputāti</span>
								<span class="text-xs font-normal text-neutral-500 tabular-nums">{ fmt.Sprint(EffectiveActiveMPCount(props)) }</span>
							</a>
						</nav>
						<div class="hidden sm:block pb-2.5 text-xs text-neutral-500">
							Neitrāls atvērtā parlamenta reģistrs
						</div>
					</div>
				</div>
			</header>

			<!-- Main Content -->
			<main id="main-content" class="flex-1 mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
				{ children... }
			</main>

			<!-- Newspaper Colophon Footer -->
			<footer class="mt-16 bg-white">
				<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
					<div class="border-t-2 border-neutral-950 pt-8 pb-10 grid grid-cols-1 md:grid-cols-12 gap-8 text-xs text-neutral-600 leading-relaxed">
						<!-- Col 1: Publication -->
						<div class="md:col-span-5 space-y-2.5">
							<div class="font-serif text-lg font-bold tracking-tight text-neutral-950">
								Kā Balso Saeima
							</div>
							<p>
								Neitrāla, atvērta pilsoniska iniciatīva, kas pārvērš Latvijas Republikas Saeimas sēžu protokolus un stenogrammas pārskatāmā, faktos balstītā arhīvā bez politiskas interpretācijas.
							</p>
							if props.Metadata.LatestSittingDate != "" || props.Metadata.TotalVotes > 0 {
								<p class="text-neutral-500 tabular-nums pt-1">
									if props.Metadata.LatestSittingDate != "" {
										<span>Pēdējā sēde: { FormatLatvianDate(props.Metadata.LatestSittingDate) }</span>
									}
									if props.Metadata.FormattedSyncDate != "" {
										<span> · Atjaunots: { FormatLatvianDate(props.Metadata.FormattedSyncDate) }</span>
									}
									if props.Metadata.TotalVotes > 0 {
										<span> · { FormatVotesCount(props.Metadata.TotalVotes) }</span>
									}
								</p>
							}
						</div>

						<!-- Col 2: Official Sources & Open Data -->
						<div class="md:col-span-3 space-y-2">
							<div class="font-semibold uppercase tracking-wider text-[11px] text-neutral-950">Avoti un atvērtie dati</div>
							<ul class="space-y-1.5">
								<li>
									<a href="https://www.saeima.lv" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition">
										Saeimas sēžu protokoli (saeima.lv) ↗
									</a>
								</li>
								<li>
									<a href="https://data.gov.lv" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition">
										Atvērto datu portāls (data.gov.lv) ↗
									</a>
								</li>
								<li>
									<a href="https://github.com/FisersDavis/kabalsosaeima" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-neutral-400 hover:decoration-neutral-950 hover:text-neutral-950 transition">
										Pirmkods GitHub ↗
									</a>
								</li>
								<li class="pt-1 text-neutral-500">
									JSON:
									<a href={ templ.SafeURL(TermURL(props.BasePath, "/data/votes.json")) } class="underline underline-offset-2 decoration-neutral-400 hover:text-neutral-950 ml-1">votes.json</a>,
									<a href={ templ.SafeURL(TermURL(props.BasePath, "/data/mps.json")) } class="underline underline-offset-2 decoration-neutral-400 hover:text-neutral-950 ml-1">mps.json</a>,
									<a href={ templ.SafeURL(TermURL(props.BasePath, "/data/mandates.json")) } class="underline underline-offset-2 decoration-neutral-400 hover:text-neutral-950 ml-1">mandates.json</a>
								</li>
							</ul>
						</div>

						<!-- Col 3: Methodology -->
						<div class="md:col-span-4 space-y-2">
							<div class="font-semibold uppercase tracking-wider text-[11px] text-neutral-950">Metodoloģija</div>
							<p>
								Saskaņā ar Satversmes 24. pantu kvorumam nepieciešami vismaz 50 balsojoši deputāti. Statusā <em>Nebalsoja</em> tiek iekļauti gan deputāti, kuri reģistrējās zālē, bet nenospieda pogu (kvoruma manevrs), gan promesošie. Apmeklētība un sakritība ar frakciju tiek rēķināta tikai par deputāta aktīvā mandāta periodiem un faktisko frakciju katra balsojuma dienā.
							</p>
						</div>
					</div>

					<div class="border-t border-neutral-200 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-neutral-500">
						<p>© 2026 kābalsosaeima.lv · Atvērtā koda pilsoniskā iniciatīva</p>
						<span>Veidots sabiedrības informēšanai un parlamenta atklātībai</span>
					</div>
				</div>
			</footer>
		</body>
	</html>
}
